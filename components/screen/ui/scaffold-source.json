"<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:;\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Настройка пространства — svaib</title>\n  <style>\n    :root {\n      --teal: #00B4A6;\n      --teal-dark: #008B7F;\n      --teal-light: #E0F7F5;\n      --teal-subtle: #F0FDFB;\n      --pink: #FF4D8D;\n      --pink-light: #FFE5ED;\n      --ink: #1A1A1A;\n      --blue: #2C3E50;\n      --gray: #6B7280;\n      --gray-2: #9CA3AF;\n      --line: #E5E7EB;\n      --bg: #FAFBFC;\n      --surface: #FFFFFF;\n      --shadow: 0 1px 3px rgba(0, 0, 0, 0.02), 0 12px 24px rgba(0, 0, 0, 0.06);\n      --radius: 8px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html {\n      overflow-y: hidden;\n      background: var(--bg);\n      color: var(--ink);\n      font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      letter-spacing: 0;\n    }\n\n    body {\n      overflow-y: hidden;\n      margin: 0;\n      min-height: 0;\n      color: var(--ink);\n      background: var(--bg);\n      line-height: 1.55;\n    }\n\n    button,\n    input {\n      font: inherit;\n    }\n\n    button {\n      appearance: none;\n      border: 1px solid var(--teal);\n      border-radius: var(--radius);\n      background: var(--surface);\n      color: var(--teal-dark);\n      padding: 9px 12px;\n      font-size: 13px;\n      font-weight: 750;\n      cursor: pointer;\n      transition: background 0.16s ease, transform 0.16s ease, border-color 0.16s ease;\n    }\n\n    button:hover {\n      background: var(--teal-subtle);\n      transform: translateY(-1px);\n    }\n\n    button.secondary {\n      border-color: var(--line);\n      color: var(--blue);\n    }\n\n    button.danger {\n      border-color: rgba(255, 77, 141, 0.45);\n      color: var(--pink);\n    }\n\n    input {\n      min-height: 38px;\n      width: 100%;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: #fff;\n      color: var(--ink);\n      padding: 8px 10px;\n      outline: none;\n    }\n\n    input:focus {\n      border-color: var(--teal);\n      box-shadow: 0 0 0 3px rgba(0, 180, 166, 0.12);\n    }\n\n    .brand-strip {\n      height: 5px;\n      background: var(--teal);\n    }\n\n    .page {\n      width: min(1480px, calc(100vw - 36px));\n      margin: 0 auto;\n      padding: 20px 0 32px;\n    }\n\n    header {\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 20px;\n      align-items: start;\n      margin-bottom: 12px;\n    }\n\n    .logo {\n      font-family: Sora, Inter, sans-serif;\n      font-size: 24px;\n      font-weight: 800;\n      line-height: 1;\n      white-space: nowrap;\n    }\n\n    .logo .teal { color: var(--teal); }\n    .logo .pink { color: var(--pink); }\n\n    h1,\n    h2,\n    h3 {\n      margin: 0;\n      color: var(--blue);\n      font-family: Sora, Inter, sans-serif;\n      letter-spacing: 0;\n    }\n\n    h1 {\n      max-width: 920px;\n      font-size: clamp(28px, 3.4vw, 48px);\n      line-height: 1.06;\n    }\n\n    h2 {\n      font-size: 21px;\n      line-height: 1.18;\n    }\n\n    h3 {\n      font-size: 16px;\n      line-height: 1.25;\n    }\n\n    p {\n      margin: 0;\n    }\n\n    .layout {\n      display: grid;\n      grid-template-columns: minmax(300px, 0.7fr) minmax(620px, 1.55fr);\n      gap: 18px;\n      align-items: start;\n    }\n\n    .panel {\n      min-width: 0;\n      border: 1px solid var(--line);\n      border-left: 6px solid var(--teal);\n      border-radius: var(--radius);\n      background: var(--surface);\n      box-shadow: var(--shadow);\n    }\n\n    .panel.accent {\n      border-left-color: var(--pink);\n    }\n\n    .panel-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 14px;\n      border-bottom: 1px solid var(--line);\n      padding: 16px 18px;\n    }\n\n    .panel-head p {\n      margin-top: 5px;\n      color: var(--gray);\n      font-size: 13px;\n    }\n\n    .tree-toolbar {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      padding: 12px 18px;\n      border-bottom: 1px solid var(--line);\n      background: var(--teal-subtle);\n    }\n\n    .tree {\n      min-height: 650px;\n      max-height: none;\n      overflow: auto;\n      padding: 18px;\n      font-family: \"SF Mono\", Menlo, Consolas, monospace;\n      font-size: 14px;\n      line-height: 1.55;\n    }\n\n    details {\n      margin: 5px 0;\n    }\n\n    summary {\n      list-style: none;\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      min-height: 30px;\n      border-radius: 6px;\n      padding: 2px 8px;\n      color: var(--blue);\n      font-weight: 800;\n      cursor: pointer;\n      white-space: nowrap;\n    }\n\n    summary::-webkit-details-marker {\n      display: none;\n    }\n\n    .add-group > summary::before {\n      content: \"+\";\n      display: inline-grid;\n      place-items: center;\n      width: 18px;\n      height: 18px;\n      border-radius: 5px;\n      background: var(--teal-light);\n      color: var(--teal-dark);\n      font-size: 12px;\n      font-weight: 900;\n    }\n\n    .add-group[open] > summary::before {\n      content: \"-\";\n      background: var(--teal);\n      color: #fff;\n    }\n\n    .folder > summary .marker {\n      display: inline-grid;\n      place-items: center;\n      width: 18px;\n      height: 18px;\n      border-radius: 5px;\n      background: var(--teal-light);\n      color: var(--teal-dark);\n      font-size: 12px;\n      font-weight: 900;\n      cursor: pointer;\n      flex: none;\n    }\n\n    .folder > summary .marker::after {\n      content: \"+\";\n    }\n\n    .folder[open] > summary .marker {\n      background: var(--teal);\n      color: #fff;\n    }\n\n    .folder[open] > summary .marker::after {\n      content: \"-\";\n    }\n\n    summary:hover,\n    .file:hover {\n      background: var(--teal-subtle);\n    }\n\n    .selected {\n      background: var(--teal-light) !important;\n      outline: 2px solid rgba(0, 180, 166, 0.22);\n    }\n\n    .children {\n      margin-left: 24px;\n      padding-left: 15px;\n      border-left: 1px solid var(--line);\n    }\n\n    .file {\n      display: flex;\n      align-items: baseline;\n      gap: 8px;\n      min-height: 28px;\n      border-radius: 6px;\n      padding: 2px 8px 2px 32px;\n      white-space: nowrap;\n      cursor: pointer;\n    }\n\n    .file::before {\n      display: inline-grid;\n      place-items: center;\n      min-width: 24px;\n      height: 18px;\n      border-radius: 5px;\n      font-size: 10px;\n      font-weight: 900;\n      text-transform: uppercase;\n    }\n\n    .file::before {\n      content: \"md\";\n      background: #F3F4F6;\n      color: var(--gray);\n    }\n\n    .muted {\n      color: var(--gray);\n      font-size: 13px;\n      white-space: normal;\n    }\n\n    .template-name {\n      color: var(--pink);\n      font-weight: 850;\n    }\n\n    .kind {\n      display: inline-flex;\n      align-items: center;\n      min-height: 18px;\n      border-radius: 5px;\n      padding: 2px 6px;\n      font-size: 10px;\n      font-weight: 900;\n      text-transform: uppercase;\n    }\n\n    .kind.unit {\n      background: var(--teal);\n      color: #fff;\n    }\n\n    .kind.aspect {\n      background: var(--teal-light);\n      color: var(--teal-dark);\n    }\n\n    .kind.kit {\n      background: #F3F4F6;\n      color: var(--blue);\n    }\n\n    .kind.infrastructure {\n      background: #F3F4F6;\n      color: var(--gray);\n    }\n\n    .kind.workspace {\n      background: var(--pink-light);\n      color: var(--pink);\n    }\n\n    .tag {\n      display: inline-flex;\n      align-items: center;\n      min-height: 24px;\n      border: 1px solid var(--line);\n      border-radius: 999px;\n      background: #fff;\n      color: var(--gray);\n      padding: 3px 8px;\n      font-size: 12px;\n      font-weight: 750;\n      white-space: nowrap;\n    }\n\n    .tag.teal {\n      border-color: var(--teal);\n      background: var(--teal-subtle);\n      color: var(--teal-dark);\n    }\n\n    .tag.pink {\n      border-color: rgba(255, 77, 141, 0.42);\n      background: #fff;\n      color: var(--pink);\n    }\n\n    .control-panel {\n      display: grid;\n      gap: 12px;\n      align-content: start;\n      position: static;\n      top: 14px;\n      max-height: none;\n      overflow: visible;\n      padding-right: 2px;\n    }\n\n    .side-body {\n      display: grid;\n      gap: 12px;\n      padding: 14px;\n    }\n\n    .field-row {\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 8px;\n    }\n\n    .quick-units,\n    .actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n\n    .info-card {\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: #fff;\n      padding: 8px 9px;\n    }\n\n    .info-card strong {\n      display: block;\n      margin-bottom: 0;\n      color: var(--blue);\n      font-family: Sora, Inter, sans-serif;\n      font-size: 15px;\n    }\n\n    .info-card p {\n      color: var(--gray);\n      font-size: 13px;\n    }\n\n    .info-top {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) auto;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .selected-name {\n      min-width: 0;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .selected-actions {\n      display: flex;\n      gap: 5px;\n      flex-wrap: nowrap;\n    }\n\n    .info-top button {\n      min-height: 28px;\n      padding: 4px 7px;\n      font-size: 11px;\n      white-space: nowrap;\n    }\n\n    .add-grid {\n      display: grid;\n      gap: 7px;\n    }\n\n    .copy-actions {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 7px;\n    }\n\n    .copy-actions button {\n      width: 100%;\n    }\n\n    .add-group {\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: #fff;\n      padding: 0;\n      overflow: hidden;\n      margin: 0;\n    }\n\n    .add-group summary {\n      display: flex;\n      justify-content: flex-start;\n      align-items: center;\n      gap: 10px;\n      width: 100%;\n      min-height: 44px;\n      padding: 10px 12px;\n      border-radius: 0;\n    }\n\n    .add-group-title {\n      display: flex;\n      justify-content: flex-start;\n      align-items: center;\n      gap: 10px;\n      color: var(--blue);\n      font-size: 13px;\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n    }\n\n    .add-group-title > span:last-child {\n      margin-left: auto;\n    }\n\n    .axis-head {\n      display: flex;\n      flex: 1;\n      min-width: 0;\n      text-align: left;\n    }\n\n    .axis-title {\n      display: grid;\n      grid-template-columns: 8px minmax(0, 1fr);\n      column-gap: 7px;\n      row-gap: 1px;\n      align-items: center;\n      width: 100%;\n      min-width: 0;\n    }\n\n    .axis-label {\n      grid-column: 2;\n      min-width: 0;\n    }\n\n    .axis-dot {\n      grid-column: 1;\n      grid-row: 1 / span 2;\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: var(--teal);\n      flex: none;\n    }\n\n    .axis-dot.aspect {\n      background: var(--blue);\n    }\n\n    .axis-dot.kit {\n      background: var(--gray);\n    }\n\n    .axis-dot.infrastructure {\n      background: var(--gray-2);\n    }\n\n    .axis-dot.workspace {\n      background: var(--pink);\n    }\n\n    .axis-subtitle {\n      grid-column: 2;\n      color: var(--gray);\n      font-size: 12px;\n      font-weight: 600;\n      line-height: 1.25;\n      letter-spacing: 0;\n      text-transform: none;\n      white-space: normal;\n    }\n\n    .add-buttons {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 8px 11px 11px;\n    }\n\n    .add-buttons button {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      width: 100%;\n      min-height: 36px;\n      text-align: left;\n      padding: 8px 11px;\n    }\n\n    .block-label {\n      min-width: 0;\n    }\n\n    .block-label-ru {\n      margin-left: 5px;\n      color: var(--gray);\n      font-size: 12px;\n      font-weight: 500;\n    }\n\n    .add-buttons button:disabled {\n      border-color: var(--teal-light);\n      background: var(--teal-subtle);\n      color: var(--teal-dark);\n      cursor: default;\n      opacity: 0.88;\n      transform: none;\n    }\n\n    .footer-note {\n      color: var(--gray);\n      font-size: 12px;\n      line-height: 1.45;\n    }\n\n    @media (max-width: 1040px) {\n      .layout,\n      header {\n        grid-template-columns: 1fr;\n      }\n\n      .tree {\n        min-height: 460px;\n        max-height: none;\n      }\n    }\n\n    @media (max-width: 680px) {\n      .page {\n        width: min(100% - 24px, 1480px);\n        padding-top: 14px;\n      }\n\n      .field-row {\n        grid-template-columns: 1fr;\n      }\n\n      .panel-head {\n        flex-direction: column;\n      }\n    }\n    [data-screen-readonly=\"true\"] .control-panel > .panel.accent,\n    [data-screen-readonly=\"true\"] #action-context,\n    [data-screen-readonly=\"true\"] #node-actions,\n    [data-screen-readonly=\"true\"] .screen-agent-actions,\n    [data-screen-readonly=\"true\"] .control-panel .footer-note { display: none; }\n  </style>\n</head>\n<body data-screen-readonly=\"true\">\n  <div class=\"brand-strip\"></div>\n  <main class=\"page\">\n    <header>\n      <div>\n        <h1>Структура пространства компании</h1>\n      </div>\n      <div class=\"logo\"><span class=\"teal\">sv</span><span class=\"pink\">ai</span><span class=\"teal\">b</span><span class=\"pink\">.</span></div>\n    </header>\n\n    <section class=\"layout\">\n      <aside class=\"control-panel\">\n        <section class=\"panel accent\">\n          <div class=\"panel-head\">\n            <div>\n              <h2>ОБЪЕКТ управления</h2>\n              <p>чем управляем</p>\n              <p id=\"unit-context\">В корень scaffold</p>\n            </div>\n          </div>\n          <div class=\"side-body\">\n            <div class=\"field-row\">\n              <input id=\"unit-name\" type=\"text\" placeholder=\"Например: sales, marketing, product\">\n              <button id=\"add-unit\" type=\"button\">Добавить</button>\n            </div>\n            <div class=\"quick-units\">\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"sales\">sales</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"marketing\">marketing</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"00_ceo\">00_ceo</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"product\">product</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"finance\">finance</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"clients\">clients</button>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"panel\">\n          <div class=\"panel-head\">\n            <div>\n              <h2>Добавить в узел</h2>\n              <p id=\"action-context\">Выберите объект управления в дереве.</p>\n            </div>\n          </div>\n          <div class=\"side-body\">\n            <div id=\"selected-info\" class=\"info-card\"></div>\n            <div id=\"node-actions\" class=\"add-grid\"></div>\n            <div class=\"screen-agent-actions\"><button id=\"screen-done\" type=\"button\">Готово — передать агенту</button><p id=\"screen-status\" class=\"footer-note\" role=\"status\"></p></div>\n            <p class=\"footer-note\">Это проект scaffold, а не физическое развёртывание. Розовые шаблонные имена нужно переименовать или удалить перед развёртыванием. Структура передаётся агенту напрямую.</p>\n          </div>\n        </section>\n      </aside>\n\n      <section class=\"panel\">\n        <div class=\"panel-head\">\n          <div>\n            <h2>Дерево клиента</h2>\n            <p id=\"tree-description\">Обязательный пакет уже показан. Остальные блоки появляются только после выбора.</p>\n          </div>\n          <span id=\"tree-mode\" class=\"tag teal\">базовая структура</span>\n        </div>\n        <div class=\"tree-toolbar\">\n          <button type=\"button\" data-action=\"expand\">Раскрыть всё</button>\n          <button type=\"button\" data-action=\"collapse\">Свернуть всё</button>\n          <button type=\"button\" data-action=\"focus\">Фокус на выбранном</button>\n        </div>\n        <div id=\"tree\" class=\"tree\"></div>\n      </section>\n    </section>\n  </main>\n\n  <script>\n    /*\n     * Company-space structure editor.\n     * It models the package and selected presets; it does not write files.\n     */\n    const blockCatalog = {\n      kit: [\n        { id: \"overview\", path: \"01_overview.md\", labelRu: \"обзор\", kind: \"file\", role: \"kit\", description: \"Состояние узла и ближайшее направление.\" },\n        { id: \"active\", path: \"02_active.md\", labelRu: \"актуальное\", kind: \"file\", role: \"kit\", description: \"Что в работе сейчас.\" },\n        { id: \"backlog\", path: \"03_backlog.md\", labelRu: \"планы\", kind: \"file\", role: \"kit\", description: \"Будущая работа, идеи и гипотезы.\" },\n        { id: \"progress\", path: \"04_progress.md\", labelRu: \"прогресс\", kind: \"file\", role: \"kit\", description: \"Хроника движения узла.\" },\n        { id: \"decisions\", path: \"05_decisions.md\", labelRu: \"решения\", kind: \"file\", role: \"kit\", description: \"Журнал решений: что и почему.\" }\n      ],\n      aspects: [\n        { id: \"strategic\", path: \"01_strategic/\", labelRu: \"стратегия\", kind: \"folder\", role: \"aspect\", description: \"Видение, цель и действующие выборы.\" },\n        { id: \"team\", path: \"02_team/\", labelRu: \"команда\", kind: \"folder\", role: \"aspect\", description: \"Люди, роли и ответственность.\" },\n        { id: \"metrics\", path: \"03_metrics/\", labelRu: \"метрики\", kind: \"folder\", role: \"aspect\", description: \"Семантика метрик и источников.\" },\n        { id: \"projects\", path: \"projects/\", labelRu: \"проекты\", kind: \"folder\", role: \"aspect\", description: \"Временные инициативы с завершением.\" },\n        { id: \"processes\", path: \"processes/\", labelRu: \"процессы\", kind: \"folder\", role: \"aspect\", description: \"Повторяемая работа и регламенты.\" },\n        { id: \"knowledge\", path: \"knowledge/\", labelRu: \"знания\", kind: \"folder\", role: \"aspect\", description: \"Обработанное знание для переиспользования.\" }\n      ],\n      infrastructure: [\n        { id: \"inbox\", path: \"_inbox/\", labelRu: \"входящее\", kind: \"folder\", role: \"infrastructure\", description: \"Локальный буфер входящего.\" },\n        { id: \"private\", path: \"_private/\", labelRu: \"приватное\", kind: \"folder\", role: \"infrastructure\", description: \"Приватные материалы участников; права настраиваются в хранилище.\" },\n        { id: \"meetings\", path: \"meetings/\", labelRu: \"встречи\", kind: \"folder\", role: \"infrastructure\", description: \"Память встреч по согласованному правилу.\" },\n        { id: \"archive\", path: \"zz_archive/\", labelRu: \"архив\", kind: \"folder\", role: \"infrastructure\", description: \"Холодный или завершённый контекст.\" }\n      ],\n      workspace: [\n        { id: \"docs\", path: \"docs/\", labelRu: \"документы\", kind: \"folder\", role: \"workspace\", description: \"Рабочие документы клиента.\" },\n        { id: \"contracts\", path: \"contracts/\", labelRu: \"договоры\", kind: \"folder\", role: \"workspace\", description: \"Договоры и юридические материалы.\" },\n        { id: \"drafts\", path: \"drafts/\", labelRu: \"черновики\", kind: \"folder\", role: \"workspace\", description: \"Черновики и рабочие материалы.\" }\n      ]\n    };\n\n    const state = {\n      selectedId: \"root\",\n      explicitUnitParentId: null,\n      renaming: false,\n      controlGroups: { aspects: false, kit: false, infrastructure: false, workspace: false },\n      nodes: {}\n    };\n\n    const treeEl = document.getElementById(\"tree\");\n    const selectedInfoEl = document.getElementById(\"selected-info\");\n    const actionsEl = document.getElementById(\"node-actions\");\n    const actionContextEl = document.getElementById(\"action-context\");\n    const unitContextEl = document.getElementById(\"unit-context\");\n    const unitInput = document.getElementById(\"unit-name\");\n    const addUnitButton = document.getElementById(\"add-unit\");\n\n\n\n\n    const screenTemplates = __SCREEN_TEMPLATES__;\n    let screenBase = null, screenLast = '', screenReadOnly = true;\n    function screenAccess(readOnly) {\n      screenReadOnly = readOnly !== false;\n      document.body.dataset.screenReadonly = String(screenReadOnly);\n      document.querySelector('.control-panel > .panel:not(.accent) h2').textContent = screenReadOnly ? 'Выбранный элемент' : 'Добавить в узел';\n      if (screenReadOnly) state.renaming = false;\n      if (screenBase) { renderInfo(); renderActions(); }\n    }\n    function escapeHtml(value) { return String(value).replace(/[&<>\"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[char])); }\n    function screenConfig() {\n      return { ...screenBase, tree: Object.values(state.nodes).map(node => ({id:node.id,parentId:findParentId(node.id),name:node.label.replace(/\\/$/,''),type:node.type,note:node.note,role:node.role,locked:node.locked,fixedName:node.fixedName,placeholder:node.placeholder,proposed:node.proposed,acceptsBlocks:node.acceptsBlocks,projectContainer:node.projectContainer,clientContainer:node.clientContainer,template:node.template,screenKind:node.screenKind})) };\n    }\n    function screenPublish() {\n      if (!screenBase || screenReadOnly) return;\n      const config = screenConfig(), json = JSON.stringify(config);\n      if (json !== screenLast) { screenLast = json; parent.postMessage({type:'screen-change',config}, '*'); }\n    }\n    function screenPublishUi() {\n      parent.postMessage({ type: 'screen-ui', ui: { selectedId: state.selectedId,\n        openIds: Object.values(state.nodes).filter(node => node.type === 'folder' && node.open).map(node => node.id),\n        controlGroups: { ...state.controlGroups } } }, '*');\n    }\n    function screenTemplate(parent, label) {\n      let candidate = null;\n      const kind = parent.screenKind;\n      if (label === 'README.md') {\n        if (kind === 'ceo' || kind === 'product' || kind === 'clients') candidate = `templates/nodes/${kind}/README.md`;\n        else if (kind === 'client') candidate = 'templates/nodes/clients/client-name/README.md';\n        else if (kind === 'unit' || kind === 'project') candidate = 'templates/nodes/unit/README.md';\n        else {\n          const folder = parent.label.replace(/\\/$/,'');\n          candidate = ['projects','processes','knowledge','03_metrics'].includes(folder) ? `templates/aspects/${folder}/README.md` : folder === 'source' || folder === 'extractors' ? `templates/aspects/03_metrics/${folder}/README.md` : folder === 'meetings' ? 'templates/meetings/README.md' : ['_inbox','zz_archive'].includes(folder) ? `templates/infrastructure/${folder}/README.md` : null;\n        }\n      } else if (kind === 'ceo') candidate = `templates/nodes/ceo/${label}`;\n      else if (kind === 'client' && ['company.md','people.md'].includes(label)) candidate = `templates/nodes/clients/client-name/${label}`;\n      else if (kind === 'product' && label === 'profile.md') candidate = 'templates/nodes/product/profile.md';\n      else if (/^0[1-5]_(overview|active|backlog|progress|decisions)\\.md$/.test(label)) candidate = `templates/management-kit/${label}`;\n      else if (['vision.md','goal.md','strategy.md'].includes(label)) candidate = `templates/aspects/01_strategic/${label}`;\n      else if (label === '01_org-structure.md' || label === 'person-name.md') candidate = `templates/aspects/02_team/${label === 'person-name.md' ? 'person.md' : label}`;\n      else if (label.endsWith('-metrics.md')) candidate = 'templates/aspects/03_metrics/domain-metrics.md';\n      else if (label === 'process-name.md') candidate = 'templates/aspects/processes/process.md';\n      return screenTemplates.includes(candidate) ? candidate : null;\n    }\n\n    function addNode(id, parentId, data) {\n      const parent = parentId ? state.nodes[parentId] : null;\n      const path = data.path || (parent ? `${parent.path}${data.label}` : data.label);\n      state.nodes[id] = {\n        id,\n        type: data.type || \"file\",\n        path,\n        label: data.label,\n        note: data.note || \"\",\n        role: data.role || \"root\",\n        locked: Boolean(data.locked),\n        fixedName: Boolean(data.fixedName),\n        placeholder: Boolean(data.placeholder),\n        proposed: Boolean(data.proposed),\n        acceptsBlocks: Boolean(data.acceptsBlocks),\n        projectContainer: Boolean(data.projectContainer),\n        clientContainer: Boolean(data.clientContainer),\n        open: Boolean(data.open),\n        template: data.template || null, screenKind: data.screenKind || null,\n        children: []\n      };\n      if (parent) parent.children.push(id);\n      return state.nodes[id];\n    }\n\n    function buildInitialTree(config, ui) {\n      const previous = state.nodes;\n      state.nodes = Object.create(null);\n      const entries = new Map(config.tree.map(item => [item.id, item]));\n      function insert(item) {\n        if (state.nodes[item.id]) return;\n        if (item.parentId) insert(entries.get(item.parentId));\n        const node = addNode(item.id, item.parentId, { ...item, label: item.name + (item.type === 'folder' ? '/' : ''), open: previous[item.id]?.open ?? (item.parentId === null || item.id === 'company' || item.name === '01_company') });\n      }\n      config.tree.forEach(insert);\n      if (ui && Array.isArray(ui.openIds)) {\n        const openIds = new Set(ui.openIds);\n        Object.values(state.nodes).forEach(node => { if (node.type === 'folder') node.open = openIds.has(node.id); });\n        if (typeof ui.selectedId === 'string' && state.nodes[ui.selectedId]) state.selectedId = ui.selectedId;\n        if (ui.controlGroups && typeof ui.controlGroups === 'object')\n          Object.keys(state.controlGroups).forEach(key => { if (typeof ui.controlGroups[key] === 'boolean') state.controlGroups[key] = ui.controlGroups[key]; });\n      }\n      const root = config.tree.find(item => item.parentId === null);\n      if (root.id !== 'root') throw new Error('Корневой ID должен быть root.');\n      const overview = Boolean(config.overview);\n      document.getElementById('tree-description').textContent = overview ? `Снимок папки: ${config.overview.capturedAt ? new Date(config.overview.capturedAt).toLocaleString('ru-RU') : 'дата чтения неизвестна'}. Глубина чтения: ${config.overview.maxDepth}. Не раскрыто папок: ${config.overview.omittedBranches}; исключено элементов: ${config.overview.omittedItems}. Для файловых изменений нужен отдельный разбор.` : 'Обязательный пакет уже показан. Остальные блоки появляются только после выбора.';\n      document.getElementById('tree-mode').textContent = overview ? 'частичный обзор' : 'базовая структура';\n      if (!state.nodes[state.selectedId]) state.selectedId = 'root';\n      if (!state.nodes[state.explicitUnitParentId]) state.explicitUnitParentId = null;\n      screenBase = { schemaVersion: 2, catalogVersion: config.catalogVersion, canonSnapshot: config.canonSnapshot, companyName: config.companyName, ...(config.overview ? {overview: config.overview} : {}) };\n      screenLast = JSON.stringify(screenConfig());\n      render();\n    }\n\n    function slugify(value) {\n      return value.trim().toLowerCase().replace(/\\.md$/i, \"\").replace(/[^a-z0-9а-яё_-]+/gi, \"-\").replace(/^-+|-+$/g, \"\");\n    }\n\n    function getNode(id) { return state.nodes[id]; }\n\n    function findParentId(childId) {\n      const parent = Object.values(state.nodes).find((node) => node.children.includes(childId));\n      return parent ? parent.id : null;\n    }\n\n    function isUnitNode(node) {\n      return Boolean(node && node.type === \"folder\" && !(screenBase?.overview && node.locked) && (node.role === \"unit\" || node.acceptsBlocks));\n    }\n\n    function getUnitParent() {\n      const explicitParent = getNode(state.explicitUnitParentId);\n      return isUnitNode(explicitParent) ? explicitParent : getNode(\"root\");\n    }\n\n    function getActionTarget() {\n      let current = getNode(state.selectedId);\n      while (current) {\n        if (isUnitNode(current)) return current;\n        current = getNode(findParentId(current.id));\n      }\n      return null;\n    }\n\n    function uniqueId(prefix) {\n      let index = 1;\n      while (state.nodes[`${prefix}-${index}`]) index += 1;\n      return `${prefix}-${index}`;\n    }\n\n    function addPresetFile(parent, suffix, label, note, role, placeholder = false, proposed = false) {\n      return addNode(uniqueId(`${parent.id}-${suffix}`), parent.id, { label, note, role, placeholder, proposed, template: screenTemplate(parent, label) });\n    }\n\n    function addPresetFolder(parent, suffix, label, note, role, options = {}) {\n      let freeLabel = label, index = 2;\n      while (parent.children.some(id => getNode(id).label === freeLabel)) freeLabel = label.replace(/\\/$/, '') + '-' + index++ + '/';\n      return addNode(uniqueId(`${parent.id}-${suffix}`), parent.id, { type: \"folder\", label: freeLabel, note, role, screenKind: suffix === 'project' ? 'project' : suffix === 'client' ? 'client' : null, ...options });\n    }\n\n    function applyUnitPreset(node, slug) {\n      node.screenKind = slug === \"00_ceo\" ? \"ceo\" : slug === \"clients\" ? \"clients\" : slug === \"product\" ? \"product\" : \"unit\";\n      if (slug === \"00_ceo\") {\n        node.note = \"опциональный личный контекст CEO\";\n        addPresetFile(node, \"readme\", \"README.md\", \"карта личного контура\", \"unit\");\n        addPresetFile(node, \"profile\", \"01_profile.md\", \"профиль CEO\", \"kit\");\n        addPresetFile(node, \"active\", \"02_active.md\", \"личные задачи и вопросы\", \"kit\");\n        addPresetFile(node, \"thoughts\", \"03_thoughts.md\", \"мысли впрок\", \"kit\");\n        addPresetFile(node, \"decisions\", \"04_decisions.md\", \"личные решения\", \"kit\");\n        return;\n      }\n      if (slug === \"clients\") {\n        node.note = \"портфель клиентов как отдельный объект управления\";\n        node.clientContainer = true;\n        addPresetFile(node, \"readme\", \"README.md\", \"карта клиентского портфеля\", \"unit\");\n        addClient(node.id);\n        return;\n      }\n      addPresetFile(node, \"readme\", \"README.md\", \"карта объекта управления\", \"unit\");\n      addPresetFile(node, \"overview\", \"01_overview.md\", \"состояние и ближайшее направление\", \"kit\");\n      if (slug === \"product\") {\n        node.note = \"продукт как самостоятельный объект управления\";\n        addPresetFile(node, \"profile\", \"profile.md\", \"паспорт продукта\", \"unit\");\n      }\n    }\n\n    function addUnit(rawName) {\n      const slug = slugify(rawName);\n      if (!slug) return;\n      const parent = slug === \"00_ceo\" ? getNode(\"root\") : getUnitParent();\n      const label = `${slug}/`;\n      if (parent.children.some((id) => getNode(id).label === label)) return;\n      const node = addNode(uniqueId(`unit-${slug}`), parent.id, {\n        type: \"folder\", label, note: \"объект управления клиента\", role: \"unit\", acceptsBlocks: true, fixedName: slug === \"00_ceo\", open: true\n      });\n      applyUnitPreset(node, slug);\n      parent.open = true;\n      if (slug !== \"clients\") {\n        state.selectedId = node.id;\n        state.renaming = false;\n      }\n      state.explicitUnitParentId = null;\n      unitInput.value = \"\";\n      render();\n    }\n\n    function addBlockPreset(node, block, parent) {\n      if (block.kind !== \"folder\") return;\n      if (block.id === \"strategic\") {\n        addPresetFile(node, \"vision\", \"vision.md\", \"идентичность и видение\", \"aspect\");\n        addPresetFile(node, \"goal\", \"goal.md\", \"цель и план\", \"aspect\");\n        addPresetFile(node, \"strategy\", \"strategy.md\", \"действующие выборы\", \"aspect\");\n      } else if (block.id === \"team\") {\n        addPresetFile(node, \"org\", \"01_org-structure.md\", \"карта ролей и подчинения\", \"aspect\");\n        addPresetFile(node, \"person\", \"person-name.md\", \"профиль человека — переименовать\", \"aspect\", true);\n      } else if (block.id === \"metrics\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта метрик\", \"aspect\");\n        addPresetFile(node, \"domain\", \"{unit}-metrics.md\", \"метрики домена — переименовать\", \"aspect\", true);\n        const source = addPresetFolder(node, \"source\", \"source/\", \"удалить, если локальных источников нет\", \"infrastructure\", { proposed: true });\n        addPresetFile(source, \"readme\", \"README.md\", \"миссия локальных источников\", \"infrastructure\");\n        const extractors = addPresetFolder(node, \"extractors\", \"extractors/\", \"удалить, если извлечение не нужно\", \"infrastructure\", { proposed: true });\n        addPresetFile(extractors, \"readme\", \"README.md\", \"миссия процедур извлечения\", \"infrastructure\");\n      } else if (block.id === \"projects\") {\n        node.projectContainer = true;\n        addPresetFile(node, \"readme\", \"README.md\", \"карта проектов\", \"aspect\");\n        addProject(node.id);\n      } else if (block.id === \"processes\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта процессов\", \"aspect\");\n        addPresetFile(node, \"process\", \"process-name.md\", \"один процесс — переименовать\", \"aspect\", true);\n      } else if (block.id === \"knowledge\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта знаний\", \"aspect\");\n        addPresetFile(node, \"topic\", \"topic.md\", \"одна тема — переименовать\", \"aspect\", true);\n      } else if (block.id === \"meetings\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта памяти встреч\", \"infrastructure\");\n      } else if (block.id === \"inbox\" || block.id === \"archive\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"миссия служебной папки\", \"infrastructure\");\n      }\n    }\n\n    function addBlock(block) {\n      const parent = getActionTarget();\n      if (!parent || parent.children.some((id) => getNode(id).label === block.path)) return;\n      const node = addNode(uniqueId(`${parent.id}-${block.id}`), parent.id, {\n        type: block.kind, label: block.path, note: block.description, role: block.role, placeholder: Boolean(block.placeholder), open: true\n      });\n      addBlockPreset(node, block, parent);\n      parent.open = true;\n      if (block.id === \"private\") {\n        node.placeholder = false;\n        const owner = addPresetFolder(node, 'owner', 'owner-name/', 'приватная папка владельца; переименовать', 'infrastructure', {placeholder:true});\n        state.selectedId = owner.id;\n        state.renaming = true;\n      } else if (block.id !== \"projects\") {\n        state.selectedId = node.id;\n        state.renaming = false;\n      }\n      render();\n    }\n\n    function addProject(containerId) {\n      const container = getNode(containerId);\n      if (!container) return;\n      const project = addPresetFolder(container, \"project\", \"project-name/\", \"проект — переименовать\", \"unit\", { acceptsBlocks: true, placeholder: true, open: true });\n      addPresetFile(project, \"readme\", \"README.md\", \"карта проекта\", \"unit\");\n      addPresetFile(project, \"overview\", \"01_overview.md\", \"состояние проекта и вклад в цель\", \"kit\");\n      state.selectedId = project.id;\n      state.renaming = true;\n    }\n\n    function addClient(containerId) {\n      const container = getNode(containerId);\n      if (!container) return;\n      const client = addPresetFolder(container, \"client\", \"client-name/\", \"клиент — переименовать\", \"unit\", { acceptsBlocks: true, placeholder: true, open: true });\n      addPresetFile(client, \"readme\", \"README.md\", \"карта клиентского проекта\", \"unit\");\n      addPresetFile(client, \"overview\", \"01_overview.md\", \"состояние клиентского проекта и вклад в цель\", \"kit\");\n      addPresetFile(client, \"company\", \"company.md\", \"контекст бизнеса клиента\", \"unit\");\n      addPresetFile(client, \"people\", \"people.md\", \"люди контрагента\", \"unit\");\n      state.selectedId = client.id;\n      state.renaming = true;\n    }\n\n    function selectNode(id) {\n      if (!getNode(id)) return;\n      state.selectedId = id;\n      state.explicitUnitParentId = isUnitNode(getNode(id)) ? id : null;\n      state.renaming = false;\n      render();\n    }\n\n    function deleteSubtree(id) {\n      const node = getNode(id);\n      if (!node) return;\n      node.children.slice().forEach(deleteSubtree);\n      delete state.nodes[id];\n    }\n\n    function hasLockedDescendant(node) {\n      return node.children.some(id => { const child = getNode(id); return child && (child.locked || hasLockedDescendant(child)); });\n    }\n\n    function removeSelected() {\n      const node = getNode(state.selectedId);\n      if (screenReadOnly || !node || node.locked || (screenBase?.overview && hasLockedDescendant(node))) return;\n      const parentId = findParentId(node.id) || \"root\";\n      const parent = getNode(parentId);\n      parent.children = parent.children.filter((id) => id !== node.id);\n      deleteSubtree(node.id);\n      state.selectedId = parentId;\n      state.renaming = false;\n      render();\n    }\n\n    function updateSubtreePaths(node, oldPath, newPath) {\n      node.path = newPath;\n      node.children.forEach((id) => {\n        const child = getNode(id);\n        updateSubtreePaths(child, oldPath, child.path.replace(oldPath, newPath));\n      });\n    }\n\n    function canRenameNode(node) {\n      return Boolean(!screenReadOnly && node && !node.locked && !node.fixedName && !(screenBase?.overview && hasLockedDescendant(node)) && (node.placeholder || (node.type === \"folder\" && node.role === \"unit\")));\n    }\n\n    function renameNode(id, rawName) {\n      const node = getNode(id);\n      if (!canRenameNode(node)) return false;\n      const slug = slugify(rawName);\n      if (!slug) return false;\n      const parent = getNode(findParentId(id));\n      const label = node.type === \"folder\" ? `${slug}/` : `${slug}.md`;\n      if (parent.children.some((childId) => childId !== id && getNode(childId).label === label)) return false;\n      const oldPath = node.path;\n      const newPath = `${parent.path}${label}`;\n      node.label = label;\n      node.placeholder = false;\n      updateSubtreePaths(node, oldPath, newPath);\n      state.renaming = false;\n      render();\n      return true;\n    }\n\n    function roleLabel(role) {\n      return ({ unit: \"объект управления\", aspect: \"ракурс\", kit: \"панель управления\", infrastructure: \"служебное\", workspace: \"рабочие материалы\" })[role] || \"роль не определена\";\n    }\n\n    function nodeRoleLabel(node) {\n      const name = node.label.replace(/\\/$/, '');\n      if (name === 'README.md') return 'карта папки';\n      if (name === '01_profile.md') return 'профиль';\n      const labels = { _inbox: 'входящее', _private: 'приватное · закрыто', meetings: 'встречи', zz_archive: 'архив' };\n      if (labels[name]) return labels[name];\n      if (node.role === 'kit') {\n        const kit = { '01_overview': 'обзор', '02_active': 'текущая работа', '03_backlog': 'будущая работа', '04_progress': 'прогресс', '05_decisions': 'решения' };\n        return kit[name.replace(/\\.md$/, '')] || roleLabel(node.role);\n      }\n      return roleLabel(node.role);\n    }\n\n    function technicalNode(node) {\n      const name = node.label.replace(/\\/$/, '');\n      if (name === '.svaib') return false;\n      const parent = getNode(findParentId(node.id));\n      if (parent?.label.replace(/\\/$/, '') === '.svaib' && ['platform.json', 'space.json', 'usage', 'cache'].includes(name)) return true;\n      return /^\\.env(?:\\.|$)/i.test(name) || ['.git', '.idea', '.vscode', '.fleet', '.cursor', '.claude', '.codex', '.agents', '.bb', '.cache', '.venv', '.next', '.nuxt', '.turbo', '.ssh', '.aws', '.azure', '.config', '.local', '.gnupg', '.npm', '.yarn', '.pnpm-store', '.pytest_cache', '.ruff_cache', '.mypy_cache', '.tox', '.gradle', '.DS_Store', '.gitignore', '.gitattributes', '.editorconfig', '.mcp.json', '.npmrc', '.yarnrc', '.yarnrc.yml', '.gitmodules', 'AGENTS.md', 'CLAUDE.md', 'node_modules', 'dist', 'build', 'coverage', '__pycache__', 'venv', 'target', 'package-lock.json', 'yarn.lock', 'pnpm-lock.yaml', 'bun.lockb', 'bun.lock', 'uv.lock', 'poetry.lock'].includes(name);\n    }\n\n    function orderedChildren(node) {\n      return node.children.slice().sort((a, b) => {\n        const left = getNode(a);\n        const right = getNode(b);\n        if (left.type !== right.type) return left.type === \"folder\" ? -1 : 1;\n        return left.label.localeCompare(right.label, \"en\", { numeric: true });\n      });\n    }\n\n    function renderNode(id) {\n      const node = getNode(id);\n      const selected = node.id === state.selectedId ? \" selected\" : \"\";\n      const nameClass = node.placeholder ? \"template-name\" : \"\";\n      const note = screenBase?.overview ? (node.id !== 'root' && node.locked && node.label.replace(/\\/$/, '') !== '_private' ? ' <span class=\"muted\">не прочитано</span>' : '') : node.note ? ` <span class=\"muted\">${node.proposed ? \"предлагается · \" : \"\"}${escapeHtml(node.note)}</span>` : \"\";\n      const kind = node.role === \"root\" ? (screenBase?.overview && node.id !== 'root' ? '<span class=\"kind\">роль не определена</span>' : \"\") : `<span class=\"kind ${node.role}\">${nodeRoleLabel(node)}</span>`;\n      if (node.type === \"folder\") {\n        const details = document.createElement(\"details\");\n        details.className = \"folder\";\n        details.open = node.open;\n        details.innerHTML = `<summary class=\"${selected}\" data-id=\"${node.id}\"><span class=\"marker\" data-toggle></span>${kind}<span class=\"${nameClass}\">${escapeHtml(node.label)}</span>${note}</summary>`;\n        const summary = details.querySelector(\"summary\");\n        summary.addEventListener(\"click\", (event) => {\n          event.preventDefault();\n          if (event.target.closest(\"[data-toggle]\")) { node.open = !details.open; details.open = node.open; screenPublishUi(); }\n          else selectNode(node.id);\n        });\n        const children = document.createElement(\"div\");\n        children.className = \"children\";\n        orderedChildren(node).filter(childId => !screenBase?.overview || !technicalNode(getNode(childId))).forEach((childId) => children.appendChild(renderNode(childId)));\n        details.appendChild(children);\n        details.addEventListener(\"toggle\", () => { node.open = details.open; screenPublishUi(); });\n        return details;\n      }\n      const file = document.createElement(\"div\");\n      file.className = `file${selected}`;\n      file.dataset.id = node.id;\n      file.innerHTML = `${kind}<span class=\"${nameClass}\">${escapeHtml(node.label)}</span>${note}`;\n      file.addEventListener(\"click\", () => selectNode(node.id));\n      return file;\n    }\n\n    function renderTree() {\n      treeEl.innerHTML = \"\";\n      treeEl.appendChild(renderNode(\"root\"));\n    }\n\n    function renderInfo() {\n      const node = getNode(state.selectedId);\n      if (!node) return;\n      const canDelete = !screenReadOnly && !node.locked && !(screenBase?.overview && hasLockedDescendant(node));\n      const canRename = canRenameNode(node);\n      if (state.renaming && canRename) {\n        const value = node.label.replace(/\\/$/, \"\").replace(/\\.md$/, \"\");\n        selectedInfoEl.innerHTML = `<div class=\"info-top\"><input id=\"rename-input\" type=\"text\" value=\"${escapeHtml(value)}\"></div><div style=\"display:flex;gap:8px;margin-top:10px\"><button type=\"button\" data-rename-save>Сохранить</button><button class=\"secondary\" type=\"button\" data-rename-cancel>Отмена</button></div><p class=\"muted\" data-rename-error style=\"margin-top:6px\"></p>`;\n        const input = selectedInfoEl.querySelector(\"#rename-input\");\n        const error = selectedInfoEl.querySelector(\"[data-rename-error]\");\n        const save = () => { if (!renameNode(node.id, input.value)) error.textContent = \"Введите свободное имя\"; };\n        input.focus(); input.select();\n        selectedInfoEl.querySelector(\"[data-rename-save]\").addEventListener(\"click\", save);\n        selectedInfoEl.querySelector(\"[data-rename-cancel]\").addEventListener(\"click\", () => { state.renaming = false; renderInfo(); });\n        input.addEventListener(\"keydown\", (event) => { if (event.key === \"Enter\") save(); if (event.key === \"Escape\") { state.renaming = false; renderInfo(); } });\n        return;\n      }\n      selectedInfoEl.innerHTML = `<div class=\"info-top\"><strong class=\"selected-name\" title=\"${escapeHtml(node.label)}\">${escapeHtml(node.label)}</strong><div class=\"selected-actions\">${canRename ? '<button class=\"secondary\" type=\"button\" data-rename-selected>Переименовать</button>' : \"\"}${canDelete ? '<button class=\"danger\" type=\"button\" data-remove-selected>Удалить</button>' : \"\"}</div></div>`;\n      selectedInfoEl.querySelector(\"[data-rename-selected]\")?.addEventListener(\"click\", () => { state.renaming = true; renderInfo(); });\n      selectedInfoEl.querySelector(\"[data-remove-selected]\")?.addEventListener(\"click\", removeSelected);\n      if (screenBase?.overview && node.note) {\n        const reason = document.createElement('p'); reason.className = 'muted'; reason.textContent = node.note; selectedInfoEl.appendChild(reason);\n      }\n    }\n\n    function renderActions() {\n      const selected = getNode(state.selectedId);\n      const target = getActionTarget();\n      actionsEl.innerHTML = \"\";\n      if (screenReadOnly) return;\n      if (screenBase?.overview && selected?.locked) {\n        actionContextEl.textContent = \"Папка не раскрыта: добавление недоступно.\";\n        return;\n      }\n      if (selected?.projectContainer) {\n        const button = document.createElement(\"button\"); button.type = \"button\"; button.textContent = \"+ Добавить проект\";\n        button.addEventListener(\"click\", () => { addProject(selected.id); render(); }); actionsEl.appendChild(button);\n      }\n      if (selected?.clientContainer) {\n        const button = document.createElement(\"button\"); button.type = \"button\"; button.textContent = \"+ Добавить клиента\";\n        button.addEventListener(\"click\", () => { addClient(selected.id); render(); }); actionsEl.appendChild(button);\n      }\n      if (!target) {\n        actionContextEl.textContent = \"Выберите объект управления в дереве.\";\n        return;\n      }\n      actionContextEl.textContent = `Добавляем в: ${target.label}`;\n      const titles = {\n        aspects: [\"РАКУРС\", \"управленческий ракурс\"], kit: [\"ПАНЕЛЬ управления\", \"состояние живой работы\"],\n        infrastructure: [\"СЛУЖЕБНЫЕ ПАПКИ\", \"инфраструктура системы\"], workspace: [\"ПАПКИ КЛИЕНТА\", \"рабочие материалы\"]\n      };\n      [\"aspects\", \"kit\", \"infrastructure\", \"workspace\"].forEach((group) => {\n        const details = document.createElement(\"details\"); details.className = \"add-group\"; details.open = state.controlGroups[group];\n        details.innerHTML = `<summary class=\"add-group-title\"><span class=\"axis-head\"><span class=\"axis-title\"><span class=\"axis-dot ${group}\"></span><span class=\"axis-label\">${titles[group][0]}</span><span class=\"axis-subtitle\">${titles[group][1]}</span></span></span><span>${blockCatalog[group].length}</span></summary>`;\n        details.addEventListener(\"toggle\", () => { state.controlGroups[group] = details.open; screenPublishUi(); });\n        const buttons = document.createElement(\"div\"); buttons.className = \"add-buttons\";\n        blockCatalog[group].forEach((block) => {\n          const exists = target.children.some((id) => getNode(id).label === block.path);\n          const button = document.createElement(\"button\"); button.type = \"button\"; button.className = \"secondary\"; button.disabled = exists;\n          button.innerHTML = `<span class=\"block-label\">${block.path}<span class=\"block-label-ru\">/ ${block.labelRu}</span></span><span>${exists ? \"✓\" : \"+\"}</span>`;\n          if (!exists) button.addEventListener(\"click\", () => addBlock(block));\n          buttons.appendChild(button);\n        });\n        details.appendChild(buttons); actionsEl.appendChild(details);\n      });\n    }\n\n    function renderUnitContext() {\n      const parent = getUnitParent();\n      unitContextEl.textContent = parent.id === \"root\" ? \"В корень scaffold\" : `Внутрь явно выбранного ${parent.label}`;\n    }\n\n    let renderedTreeSignature = '';\n    function render() {\n      const signature = JSON.stringify(Object.values(state.nodes).map(({open, ...node}) => node));\n      if (signature !== renderedTreeSignature) { renderTree(); renderedTreeSignature = signature; }\n      else {\n        treeEl.querySelectorAll('[data-id]').forEach(element => element.classList.toggle('selected', element.dataset.id === state.selectedId));\n        treeEl.querySelectorAll('details.folder').forEach(details => { const node = getNode(details.querySelector('summary')?.dataset.id); if (node) details.open = node.open; });\n      }\n      renderInfo(); renderActions(); renderUnitContext(); screenPublish(); screenPublishUi();\n    }\n\n    function setAllOpen(value) { Object.values(state.nodes).forEach((node) => { if (node.type === \"folder\") node.open = value; }); render(); }\n    function collapseToRoot() { Object.values(state.nodes).forEach((node) => { if (node.type === \"folder\") node.open = node.id === \"root\"; }); render(); }\n    function focusSelected() {\n      const open = new Set(); let id = state.selectedId;\n      while (id) { open.add(id); id = findParentId(id); }\n      Object.values(state.nodes).forEach((node) => { if (node.type === \"folder\") node.open = open.has(node.id); }); render();\n    }\n\n    addUnitButton.addEventListener(\"click\", () => addUnit(unitInput.value));\n    unitInput.addEventListener(\"keydown\", (event) => { if (event.key === \"Enter\") addUnit(unitInput.value); });\n    document.querySelectorAll(\"[data-quick-unit]\").forEach((button) => button.addEventListener(\"click\", () => addUnit(button.dataset.quickUnit)));\n    document.querySelector(\"[data-action='expand']\").addEventListener(\"click\", () => setAllOpen(true));\n    document.querySelector(\"[data-action='collapse']\").addEventListener(\"click\", collapseToRoot);\n    document.querySelector(\"[data-action='focus']\").addEventListener(\"click\", focusSelected);\n    document.getElementById('screen-done').addEventListener('click', () => { if (!screenReadOnly) parent.postMessage({type:'screen-handoff',config:screenConfig()}, '*'); });\n    window.addEventListener('message', event => {\n      if (event.source !== parent) return;\n      if (event.data?.type === 'screen-init') { screenAccess(event.data.readOnly); buildInitialTree(event.data.config, event.data.ui); }\n      if (event.data?.type === 'screen-access') screenAccess(event.data.readOnly);\n      if (event.data?.type === 'screen-status') {\n        const button = document.getElementById('screen-done');\n        button.disabled = Boolean(event.data.busy); button.textContent = event.data.busy ? 'Передаю…' : 'Готово — передать агенту';\n        document.querySelector('.page').inert = Boolean(event.data.busy);\n        if (event.data.message !== undefined) document.getElementById('screen-status').textContent = event.data.message;\n      }\n    });\n    let screenHeight = 0, screenResizeFrame = 0;\n    function screenResize() {\n      cancelAnimationFrame(screenResizeFrame);\n      screenResizeFrame = requestAnimationFrame(() => {\n        // Measure content, never viewport/scrollHeight: iframe height must not feed back into itself.\n        const height = Math.ceil(document.querySelector('.page').getBoundingClientRect().bottom + scrollY);\n        if (height !== screenHeight) { screenHeight = height; parent.postMessage({type:'screen-resize',height}, '*'); }\n      });\n    }\n    new ResizeObserver(screenResize).observe(document.querySelector('.page'));\n    window.addEventListener('resize', screenResize);\n    parent.postMessage({type:'screen-ready'}, '*');\n    screenResize();\n  </script>\n</body>\n</html>\n"
