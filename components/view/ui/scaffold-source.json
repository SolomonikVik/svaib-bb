"<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:;\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Настройка пространства — svaib</title>\n  <style>\n    :root {\n      --teal: #00B4A6;\n      --teal-dark: #008B7F;\n      --teal-light: #E0F7F5;\n      --teal-subtle: #F0FDFB;\n      --pink: #FF4D8D;\n      --pink-light: #FFE5ED;\n      --ink: #1A1A1A;\n      --blue: #2C3E50;\n      --gray: #6B7280;\n      --gray-2: #9CA3AF;\n      --line: #E5E7EB;\n      --bg: #FAFBFC;\n      --surface: #FFFFFF;\n      --shadow: 0 1px 3px rgba(0, 0, 0, 0.02), 0 12px 24px rgba(0, 0, 0, 0.06);\n      --radius: 8px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html {\n      background: var(--bg);\n      color: var(--ink);\n      font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      letter-spacing: 0;\n    }\n\n    body {\n      margin: 0;\n      min-height: 100vh;\n      color: var(--ink);\n      background: var(--bg);\n      line-height: 1.55;\n    }\n\n    button,\n    input {\n      font: inherit;\n    }\n\n    button {\n      appearance: none;\n      border: 1px solid var(--teal);\n      border-radius: var(--radius);\n      background: var(--surface);\n      color: var(--teal-dark);\n      padding: 9px 12px;\n      font-size: 13px;\n      font-weight: 750;\n      cursor: pointer;\n      transition: background 0.16s ease, transform 0.16s ease, border-color 0.16s ease;\n    }\n\n    button:hover {\n      background: var(--teal-subtle);\n      transform: translateY(-1px);\n    }\n\n    button.secondary {\n      border-color: var(--line);\n      color: var(--blue);\n    }\n\n    button.danger {\n      border-color: rgba(255, 77, 141, 0.45);\n      color: var(--pink);\n    }\n\n    input {\n      min-height: 38px;\n      width: 100%;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: #fff;\n      color: var(--ink);\n      padding: 8px 10px;\n      outline: none;\n    }\n\n    input:focus {\n      border-color: var(--teal);\n      box-shadow: 0 0 0 3px rgba(0, 180, 166, 0.12);\n    }\n\n    .brand-strip {\n      height: 5px;\n      background: var(--teal);\n    }\n\n    .page {\n      width: min(1480px, calc(100vw - 36px));\n      margin: 0 auto;\n      padding: 20px 0 32px;\n    }\n\n    header {\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 20px;\n      align-items: start;\n      margin-bottom: 12px;\n    }\n\n    .logo {\n      font-family: Sora, Inter, sans-serif;\n      font-size: 24px;\n      font-weight: 800;\n      line-height: 1;\n      white-space: nowrap;\n    }\n\n    .logo .teal { color: var(--teal); }\n    .logo .pink { color: var(--pink); }\n\n    h1,\n    h2,\n    h3 {\n      margin: 0;\n      color: var(--blue);\n      font-family: Sora, Inter, sans-serif;\n      letter-spacing: 0;\n    }\n\n    h1 {\n      max-width: 920px;\n      font-size: clamp(28px, 3.4vw, 48px);\n      line-height: 1.06;\n    }\n\n    h2 {\n      font-size: 21px;\n      line-height: 1.18;\n    }\n\n    h3 {\n      font-size: 16px;\n      line-height: 1.25;\n    }\n\n    p {\n      margin: 0;\n    }\n\n    .layout {\n      display: grid;\n      grid-template-columns: minmax(300px, 0.7fr) minmax(620px, 1.55fr);\n      gap: 18px;\n      align-items: start;\n    }\n\n    .panel {\n      min-width: 0;\n      border: 1px solid var(--line);\n      border-left: 6px solid var(--teal);\n      border-radius: var(--radius);\n      background: var(--surface);\n      box-shadow: var(--shadow);\n    }\n\n    .panel.accent {\n      border-left-color: var(--pink);\n    }\n\n    .panel-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 14px;\n      border-bottom: 1px solid var(--line);\n      padding: 16px 18px;\n    }\n\n    .panel-head p {\n      margin-top: 5px;\n      color: var(--gray);\n      font-size: 13px;\n    }\n\n    .tree-toolbar {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 8px;\n      padding: 12px 18px;\n      border-bottom: 1px solid var(--line);\n      background: var(--teal-subtle);\n    }\n\n    .tree {\n      min-height: 650px;\n      max-height: calc(100vh - 170px);\n      overflow: auto;\n      padding: 18px;\n      font-family: \"SF Mono\", Menlo, Consolas, monospace;\n      font-size: 14px;\n      line-height: 1.55;\n    }\n\n    details {\n      margin: 5px 0;\n    }\n\n    summary {\n      list-style: none;\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      min-height: 30px;\n      border-radius: 6px;\n      padding: 2px 8px;\n      color: var(--blue);\n      font-weight: 800;\n      cursor: pointer;\n      white-space: nowrap;\n    }\n\n    summary::-webkit-details-marker {\n      display: none;\n    }\n\n    .add-group > summary::before {\n      content: \"+\";\n      display: inline-grid;\n      place-items: center;\n      width: 18px;\n      height: 18px;\n      border-radius: 5px;\n      background: var(--teal-light);\n      color: var(--teal-dark);\n      font-size: 12px;\n      font-weight: 900;\n    }\n\n    .add-group[open] > summary::before {\n      content: \"-\";\n      background: var(--teal);\n      color: #fff;\n    }\n\n    .folder > summary .marker {\n      display: inline-grid;\n      place-items: center;\n      width: 18px;\n      height: 18px;\n      border-radius: 5px;\n      background: var(--teal-light);\n      color: var(--teal-dark);\n      font-size: 12px;\n      font-weight: 900;\n      cursor: pointer;\n      flex: none;\n    }\n\n    .folder > summary .marker::after {\n      content: \"+\";\n    }\n\n    .folder[open] > summary .marker {\n      background: var(--teal);\n      color: #fff;\n    }\n\n    .folder[open] > summary .marker::after {\n      content: \"-\";\n    }\n\n    summary:hover,\n    .file:hover {\n      background: var(--teal-subtle);\n    }\n\n    .selected {\n      background: var(--teal-light) !important;\n      outline: 2px solid rgba(0, 180, 166, 0.22);\n    }\n\n    .children {\n      margin-left: 24px;\n      padding-left: 15px;\n      border-left: 1px solid var(--line);\n    }\n\n    .file {\n      display: flex;\n      align-items: baseline;\n      gap: 8px;\n      min-height: 28px;\n      border-radius: 6px;\n      padding: 2px 8px 2px 32px;\n      white-space: nowrap;\n      cursor: pointer;\n    }\n\n    .file::before {\n      display: inline-grid;\n      place-items: center;\n      min-width: 24px;\n      height: 18px;\n      border-radius: 5px;\n      font-size: 10px;\n      font-weight: 900;\n      text-transform: uppercase;\n    }\n\n    .file::before {\n      content: \"md\";\n      background: #F3F4F6;\n      color: var(--gray);\n    }\n\n    .muted {\n      color: var(--gray);\n      font-size: 13px;\n      white-space: normal;\n    }\n\n    .template-name {\n      color: var(--pink);\n      font-weight: 850;\n    }\n\n    .kind {\n      display: inline-flex;\n      align-items: center;\n      min-height: 18px;\n      border-radius: 5px;\n      padding: 2px 6px;\n      font-size: 10px;\n      font-weight: 900;\n      text-transform: uppercase;\n    }\n\n    .kind.unit {\n      background: var(--teal);\n      color: #fff;\n    }\n\n    .kind.aspect {\n      background: var(--teal-light);\n      color: var(--teal-dark);\n    }\n\n    .kind.kit {\n      background: #F3F4F6;\n      color: var(--blue);\n    }\n\n    .kind.infrastructure {\n      background: #F3F4F6;\n      color: var(--gray);\n    }\n\n    .kind.workspace {\n      background: var(--pink-light);\n      color: var(--pink);\n    }\n\n    .tag {\n      display: inline-flex;\n      align-items: center;\n      min-height: 24px;\n      border: 1px solid var(--line);\n      border-radius: 999px;\n      background: #fff;\n      color: var(--gray);\n      padding: 3px 8px;\n      font-size: 12px;\n      font-weight: 750;\n      white-space: nowrap;\n    }\n\n    .tag.teal {\n      border-color: var(--teal);\n      background: var(--teal-subtle);\n      color: var(--teal-dark);\n    }\n\n    .tag.pink {\n      border-color: rgba(255, 77, 141, 0.42);\n      background: #fff;\n      color: var(--pink);\n    }\n\n    .control-panel {\n      display: grid;\n      gap: 12px;\n      align-content: start;\n      position: sticky;\n      top: 14px;\n      max-height: calc(100vh - 28px);\n      overflow: auto;\n      padding-right: 2px;\n    }\n\n    .side-body {\n      display: grid;\n      gap: 12px;\n      padding: 14px;\n    }\n\n    .field-row {\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 8px;\n    }\n\n    .quick-units,\n    .actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n\n    .info-card {\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: #fff;\n      padding: 8px 9px;\n    }\n\n    .info-card strong {\n      display: block;\n      margin-bottom: 0;\n      color: var(--blue);\n      font-family: Sora, Inter, sans-serif;\n      font-size: 15px;\n    }\n\n    .info-card p {\n      color: var(--gray);\n      font-size: 13px;\n    }\n\n    .info-top {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) auto;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .selected-name {\n      min-width: 0;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .selected-actions {\n      display: flex;\n      gap: 5px;\n      flex-wrap: nowrap;\n    }\n\n    .info-top button {\n      min-height: 28px;\n      padding: 4px 7px;\n      font-size: 11px;\n      white-space: nowrap;\n    }\n\n    .add-grid {\n      display: grid;\n      gap: 7px;\n    }\n\n    .copy-actions {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 7px;\n    }\n\n    .copy-actions button {\n      width: 100%;\n    }\n\n    .add-group {\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: #fff;\n      padding: 0;\n      overflow: hidden;\n      margin: 0;\n    }\n\n    .add-group summary {\n      display: flex;\n      justify-content: flex-start;\n      align-items: center;\n      gap: 10px;\n      width: 100%;\n      min-height: 44px;\n      padding: 10px 12px;\n      border-radius: 0;\n    }\n\n    .add-group-title {\n      display: flex;\n      justify-content: flex-start;\n      align-items: center;\n      gap: 10px;\n      color: var(--blue);\n      font-size: 13px;\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n    }\n\n    .add-group-title > span:last-child {\n      margin-left: auto;\n    }\n\n    .axis-head {\n      display: flex;\n      flex: 1;\n      min-width: 0;\n      text-align: left;\n    }\n\n    .axis-title {\n      display: grid;\n      grid-template-columns: 8px minmax(0, 1fr);\n      column-gap: 7px;\n      row-gap: 1px;\n      align-items: center;\n      width: 100%;\n      min-width: 0;\n    }\n\n    .axis-label {\n      grid-column: 2;\n      min-width: 0;\n    }\n\n    .axis-dot {\n      grid-column: 1;\n      grid-row: 1 / span 2;\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: var(--teal);\n      flex: none;\n    }\n\n    .axis-dot.aspect {\n      background: var(--blue);\n    }\n\n    .axis-dot.kit {\n      background: var(--gray);\n    }\n\n    .axis-dot.infrastructure {\n      background: var(--gray-2);\n    }\n\n    .axis-dot.workspace {\n      background: var(--pink);\n    }\n\n    .axis-subtitle {\n      grid-column: 2;\n      color: var(--gray);\n      font-size: 12px;\n      font-weight: 600;\n      line-height: 1.25;\n      letter-spacing: 0;\n      text-transform: none;\n      white-space: normal;\n    }\n\n    .add-buttons {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 8px 11px 11px;\n    }\n\n    .add-buttons button {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      width: 100%;\n      min-height: 36px;\n      text-align: left;\n      padding: 8px 11px;\n    }\n\n    .block-label {\n      min-width: 0;\n    }\n\n    .block-label-ru {\n      margin-left: 5px;\n      color: var(--gray);\n      font-size: 12px;\n      font-weight: 500;\n    }\n\n    .add-buttons button:disabled {\n      border-color: var(--teal-light);\n      background: var(--teal-subtle);\n      color: var(--teal-dark);\n      cursor: default;\n      opacity: 0.88;\n      transform: none;\n    }\n\n    .footer-note {\n      color: var(--gray);\n      font-size: 12px;\n      line-height: 1.45;\n    }\n\n    .toggle {\n      display: inline-flex;\n      align-items: center;\n      gap: 7px;\n      margin-left: auto;\n      color: var(--blue);\n      font-size: 13px;\n      font-weight: 750;\n      cursor: pointer;\n      user-select: none;\n    }\n\n    .toggle input {\n      width: 16px;\n      height: 16px;\n      min-height: 0;\n      margin: 0;\n      padding: 0;\n      accent-color: var(--teal);\n      cursor: pointer;\n    }\n\n    .toggle input:focus {\n      box-shadow: none;\n    }\n\n    .help-overlay {\n      position: fixed;\n      inset: 0;\n      z-index: 50;\n      display: grid;\n      place-items: center;\n      padding: 24px;\n      background: rgba(26, 26, 26, 0.42);\n    }\n\n    .help-overlay[hidden] {\n      display: none;\n    }\n\n    .help-dialog {\n      width: min(1040px, 100%);\n      max-height: calc(100vh - 48px);\n      overflow: auto;\n      border: 1px solid var(--line);\n      border-left: 6px solid var(--teal);\n      border-radius: var(--radius);\n      background: var(--surface);\n      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);\n    }\n\n    .help-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 14px;\n      border-bottom: 1px solid var(--line);\n      padding: 16px 20px;\n    }\n\n    .help-head h2 {\n      font-family: \"SF Mono\", Menlo, Consolas, monospace;\n    }\n\n    .help-head p {\n      margin-top: 4px;\n      color: var(--gray);\n      font-size: 14px;\n    }\n\n    .help-body {\n      display: grid;\n      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);\n      gap: 22px;\n      padding: 18px 20px 22px;\n    }\n\n    .help-body h3 {\n      margin: 0 0 6px;\n      color: var(--teal-dark);\n      font-size: 12px;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n    }\n\n    .help-text {\n      display: grid;\n      align-content: start;\n      gap: 16px;\n      font-size: 14px;\n    }\n\n    .help-text ul {\n      display: grid;\n      gap: 4px;\n      margin: 0;\n      padding-left: 18px;\n    }\n\n    .help-text b {\n      color: var(--blue);\n    }\n\n    .help-sample {\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: var(--bg);\n      padding: 6px 16px 14px;\n      color: var(--ink);\n      font-size: 13.5px;\n      line-height: 1.5;\n    }\n\n    .help-sample .md-h {\n      margin: 12px 0 4px;\n      color: var(--blue);\n      font-family: Sora, Inter, sans-serif;\n      font-weight: 800;\n      line-height: 1.25;\n    }\n\n    .help-sample .md-h1 { font-size: 18px; }\n    .help-sample .md-h2 { font-size: 15px; }\n    .help-sample .md-h3 { font-size: 13.5px; color: var(--gray); }\n\n    .help-sample .md-p {\n      margin: 0 0 6px;\n    }\n\n    .help-sample .md-list {\n      margin: 0 0 6px;\n      padding-left: 18px;\n    }\n\n    .help-sample .md-task {\n      list-style: none;\n      margin-left: -18px;\n      display: flex;\n      gap: 7px;\n      align-items: baseline;\n    }\n\n    .help-sample .md-box {\n      display: inline-block;\n      flex: none;\n      width: 11px;\n      height: 11px;\n      border: 1.5px solid var(--gray-2);\n      border-radius: 3px;\n    }\n\n    .help-sample .md-link {\n      color: var(--teal-dark);\n      text-decoration: underline;\n      text-decoration-style: dotted;\n    }\n\n    .help-sample .md-table {\n      width: 100%;\n      margin: 2px 0 6px;\n      border-collapse: collapse;\n      font-size: 12.5px;\n    }\n\n    .help-sample .md-table th,\n    .help-sample .md-table td {\n      border: 1px solid var(--line);\n      padding: 3px 7px;\n      text-align: left;\n    }\n\n    .help-sample .md-table th {\n      background: #fff;\n      color: var(--blue);\n    }\n\n    .help-sample .md-meta {\n      margin: 10px 0 4px;\n      border-left: 3px solid var(--line);\n      padding: 2px 10px;\n      color: var(--gray);\n      font-family: \"SF Mono\", Menlo, Consolas, monospace;\n      font-size: 12px;\n    }\n\n    .help-dot {\n      display: inline-grid;\n      place-items: center;\n      flex: none;\n      align-self: center;\n      width: 14px;\n      height: 14px;\n      border: 1px solid var(--gray-2);\n      border-radius: 50%;\n      background: #fff;\n      color: var(--gray);\n      font-family: Inter, sans-serif;\n      font-size: 9px;\n      font-weight: 800;\n      line-height: 1;\n      cursor: pointer;\n    }\n\n    .help-dot:hover {\n      border-color: var(--teal);\n      background: var(--teal);\n      color: #fff;\n    }\n\n    @media (max-width: 1040px) {\n      .layout,\n      header,\n      .help-body {\n        grid-template-columns: 1fr;\n      }\n\n      .tree {\n        min-height: 460px;\n        max-height: none;\n      }\n    }\n\n    @media (max-width: 680px) {\n      .page {\n        width: min(100% - 24px, 1480px);\n        padding-top: 14px;\n      }\n\n      .field-row {\n        grid-template-columns: 1fr;\n      }\n\n      .panel-head {\n        flex-direction: column;\n      }\n    }\n    html, body { overflow-y: hidden; }\n    body { min-height: 0; }\n    .tree { max-height: none; }\n    .control-panel { position: static; max-height: none; overflow: visible; }\n    .kind.custom { background: #F1EAFE; color: #7040A1; }\n    .custom-purpose { color: #7040A1; font-size: 12px; white-space: normal; }\n    .help-overlay { position: absolute; place-items: start center; }\n    [data-view-readonly=\"true\"] .control-panel > .panel.accent,\n    [data-view-readonly=\"true\"] #action-context,\n    [data-view-readonly=\"true\"] #node-actions,\n    [data-view-readonly=\"true\"] .view-agent-actions,\n    [data-view-readonly=\"true\"] .control-panel .footer-note { display: none; }\n  </style>\n</head>\n<body data-view-readonly=\"true\">\n  <div class=\"brand-strip\"></div>\n  <main class=\"page\">\n    <header>\n      <div>\n        <h1>Структура пространства компании</h1>\n      </div>\n      <div class=\"logo\"><span class=\"teal\">sv</span><span class=\"pink\">ai</span><span class=\"teal\">b</span><span class=\"pink\">.</span></div>\n    </header>\n\n    <section class=\"layout\">\n      <aside class=\"control-panel\">\n        <section class=\"panel accent\">\n          <div class=\"panel-head\">\n            <div>\n              <h2>ОБЪЕКТ управления</h2>\n              <p>чем управляем</p>\n              <p id=\"unit-context\">В корень пространства</p>\n            </div>\n          </div>\n          <div class=\"side-body\">\n            <div class=\"field-row\">\n              <input id=\"unit-name\" type=\"text\" placeholder=\"Например: продажи, маркетинг, производство\">\n              <button id=\"add-unit\" type=\"button\">Добавить</button>\n            </div>\n            <div class=\"quick-units\">\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"маркетинг\">маркетинг</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"продажи\">продажи</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"производство\">производство</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"филиал\">филиал</button>\n              <button class=\"secondary\" type=\"button\" data-quick-unit=\"клиенты\">клиенты</button>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"panel\">\n          <div class=\"panel-head\">\n            <div>\n              <h2>Добавить в узел</h2>\n              <p id=\"action-context\">Выберите объект управления в дереве.</p>\n            </div>\n          </div>\n          <div class=\"side-body\">\n            <div id=\"selected-info\" class=\"info-card\"></div>\n            <div id=\"node-actions\" class=\"add-grid\"></div>\n            <div class=\"view-agent-actions\"><button id=\"view-done\" type=\"button\">Готово — передать агенту</button><p id=\"view-status\" class=\"footer-note\" role=\"status\"></p></div>\n            <p class=\"footer-note\">Это план пространства, а не развёртывание. Розовые заготовки переименуйте или удалите. Структура передаётся агенту напрямую.</p>\n          </div>\n        </section>\n      </aside>\n\n      <section class=\"panel\">\n        <div class=\"panel-head\">\n          <div>\n            <h2>Дерево пространства</h2>\n            <p id=\"tree-description\">Обязательная основа уже показана. Остальное добавляется по выбору.</p>\n          </div>\n          <span id=\"tree-mode\" class=\"tag teal\">базовая структура</span>\n        </div>\n        <div class=\"tree-toolbar\">\n          <button type=\"button\" data-action=\"expand\">Раскрыть всё</button>\n          <button type=\"button\" data-action=\"collapse\">Свернуть всё</button>\n          <button type=\"button\" data-action=\"focus\">Фокус на выбранном</button>\n          <label class=\"toggle\"><input id=\"show-service\" type=\"checkbox\"> Служебные папки</label>\n        </div>\n        <div id=\"tree\" class=\"tree\"></div>\n      </section>\n    </section>\n  </main>\n\n  <div id=\"help-overlay\" class=\"help-overlay\" hidden>\n    <section class=\"help-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-title\">\n      <div class=\"help-head\">\n        <div>\n          <h2 id=\"help-title\"></h2>\n          <p id=\"help-subtitle\"></p>\n        </div>\n        <button class=\"secondary\" type=\"button\" data-help-close aria-label=\"Закрыть\">✕</button>\n      </div>\n      <div id=\"help-body\" class=\"help-body\"></div>\n    </section>\n  </div>\n\n  <script>\n    /*\n     * Конструктор пространства: план структуры с принятыми русскими именами.\n     * Моделирует основу и выбранные заготовки; файлов не пишет.\n     */\n    const blockCatalog = {\n      kit: [\n        { id: \"overview\", path: \"_вводная.md\", labelRu: \"что это, куда идёт\", kind: \"file\", role: \"kit\", description: \"Что это, кто отвечает, куда идёт и почему.\" },\n        { id: \"active\", path: \"_делаем.md\", labelRu: \"что в работе\", kind: \"file\", role: \"kit\", description: \"Что в работе сейчас: задачи, открытые вопросы, повестка ближайшей встречи.\" },\n        { id: \"backlog\", path: \"_планы.md\", labelRu: \"что дальше\", kind: \"file\", role: \"kit\", description: \"Что дальше, после текущего: план и идеи.\" },\n        { id: \"decisions\", path: \"_решения.md\", labelRu: \"что решили\", kind: \"file\", role: \"kit\", description: \"Что решили и почему.\" },\n        { id: \"progress\", path: \"_хроника.md\", labelRu: \"что было\", kind: \"file\", role: \"kit\", description: \"Что происходило.\" }\n      ],\n      aspects: [\n        { id: \"strategic\", path: \"00_стратегия/\", labelRu: \"видение, цели, стратегия\", kind: \"folder\", role: \"aspect\", description: \"Видение, цели, стратегия.\" },\n        { id: \"team\", path: \"00_команда/\", labelRu: \"оргструктура, сотрудники\", kind: \"folder\", role: \"aspect\", description: \"Оргструктура, профили и папки сотрудников.\" },\n        { id: \"metrics\", path: \"00_показатели/\", labelRu: \"показатели и источники\", kind: \"folder\", role: \"aspect\", description: \"Показатели и их источники; цели — в 00_стратегия/цели.md.\" },\n        { id: \"finance\", path: \"00_финансы/\", labelRu: \"как зарабатываем\", kind: \"folder\", role: \"aspect\", description: \"Как зарабатываем: модель, статьи, рентабельность.\" },\n        { id: \"projects\", path: \"00_проекты/\", labelRu: \"папки проектов\", kind: \"folder\", role: \"aspect\", description: \"Папки проектов.\" },\n        { id: \"processes\", path: \"00_процессы/\", labelRu: \"повторяемая работа\", kind: \"folder\", role: \"aspect\", description: \"Повторяемая работа: файл или папка на процесс.\" }\n      ],\n      infrastructure: [\n        { id: \"inbox\", path: \"_входящее/\", labelRu: \"неразобранное\", kind: \"folder\", role: \"infrastructure\", description: \"Неразобранное: то, что пришло и ещё не разложено по местам.\" },\n        { id: \"private\", path: \"_личное/\", labelRu: \"папка сотрудника\", kind: \"folder\", role: \"infrastructure\", description: \"Папка сотрудника в 00_команда/ с профилем и его _личное/: видит только он и его агент; права настраиваются в хранилище.\" },\n        { id: \"meetings\", path: \"_встречи/\", labelRu: \"по папке на встречу\", kind: \"folder\", role: \"infrastructure\", description: \"По папке на встречу; у ритма управления своей папки нет.\" },\n        { id: \"archive\", path: \"_архив/\", labelRu: \"уже не действует\", kind: \"folder\", role: \"infrastructure\", description: \"То, что уже не действует.\" }\n      ],\n      workspace: [\n        { id: \"docs\", path: \"документы/\", labelRu: \"рабочие документы\", kind: \"folder\", role: \"workspace\", description: \"Рабочие документы.\" },\n        { id: \"contracts\", path: \"договоры/\", labelRu: \"юридическое\", kind: \"folder\", role: \"workspace\", description: \"Договоры и юридические материалы.\" },\n        { id: \"drafts\", path: \"черновики/\", labelRu: \"в работе\", kind: \"folder\", role: \"workspace\", description: \"Черновики и рабочие материалы.\" },\n        { id: \"knowledge\", path: \"база-знаний/\", labelRu: \"обработанное знание\", kind: \"folder\", role: \"workspace\", description: \"Обработанное знание по темам; регламенты — в 00_процессы/.\" }\n      ]\n    };\n\n    // Справка по файлу: сжато из спецификаций файлов, образец — как файл выглядит.\n    const helpCatalog = {\n      overview: {\n        title: \"_вводная.md\",\n        subtitle: \"что это, кто отвечает, куда идёт и почему\",\n        why: \"Самое главное об объекте: прочитал за минуту — понял, что это, кто отвечает, куда идём и почему. Пока у темы нет своего файла, она коротко записана здесь; появился файл — остаётся ссылка. У компании вводной нет: её роль играют видение, цели и стратегия.\",\n        inside: [\n          [\"Суть\", \"что за объект, за что отвечает и за что нет; две-три фразы\"],\n          [\"Цели и метрики успеха\", \"цель, на какую цель работает, по чему поймём, что дошли\"],\n          [\"Как двигаемся\", \"набросок крупными шагами, без дат; появился план — ссылка на него\"],\n          [\"Команда\", \"ответственный — всегда, ниже — кто участвует\"],\n          [\"Условия\", \"если есть: формат, бюджет, сроки\"],\n          [\"Важно знать\", \"по желанию: что надо понимать сразу\"]\n        ],\n        notes: [[\"Чего здесь нет\", \"Истории — она в хронике, задач — они в «делаем», подробного плана — он в «планах», карты папки — она в README.\"]],\n        sample: `## ❇️ Суть\nСтроим жилой дом на 24 квартиры. Отвечаем за стройку от котлована до сдачи; продажа квартир — у отдела продаж.\n\n## 🎯 Цели и метрики успеха\n**Цель:** сдать дом в срок и в бюджете.\n\n**Работает на:** [сдать два дома в 2027 году](../../_вводная.md)\n\n**Метрики успеха:** [перерасход бюджета](../../00_показатели/показатели-операций.md#перерасход-бюджета) — не больше 5%.\n\n## 🚩 Как двигаемся\nФундамент готов, возводим этажи. Дальше отделка и сдача.\n\n## 👥 Команда\n**Ответственный:** Иван Петров, руководитель проекта → [профиль](../../00_команда/иван-петров.md)\n- **Прораб** — Сергей Ким\n\n## ❇️ Условия\nБюджет: 180 млн ₽ · Сроки: 2026-03 — 2027-06\n\n## ❇️ Важно знать\n- Заказчик принимает работы поэтажно: без приёмки этажа нет оплаты.`\n      },\n      readme: {\n        title: \"README.md\",\n        subtitle: \"карта папки\",\n        why: \"Табличка на двери: что лежит в папке, что читать под задачу и куда класть новое. Главный читатель — агент: по README он находит нужное, не открывая всё подряд.\",\n        inside: [\n          [\"Заголовок\", \"одна-две фразы о том, что это за папка\"],\n          [\"Содержимое папки\", \"каждый файл и папка: зачем он и когда его читать\"],\n          [\"Маршруты чтения\", \"задача → что читать\"],\n          [\"Маршруты записи\", \"что пришло → куда писать\"],\n          [\"Правила работы и связанные папки\", \"если они есть\"]\n        ],\n        notes: [[\"Правило\", \"Блок появляется, когда в него есть что записать; пустых заготовок нет.\"]],\n        sample: `# маркетинг — направление\n\nПапка маркетинга: фокус, текущая работа, решения и показатели направления.\n\n## Содержимое папки\n- [_вводная.md](_вводная.md) — что это, кто отвечает, куда идёт и почему. Читать: первым\n- [_делаем.md](_делаем.md) — что в работе сейчас. Читать: перед встречей\n- [_решения.md](_решения.md) — что решили и почему. Читать: когда нужен мотив\n- [00_показатели/](00_показатели/README.md) — показатели маркетинга\n\n## Маршруты чтения\n- понять, что происходит → _вводная.md → _делаем.md\n- цифры направления → 00_показатели/\n\n## Маршруты записи\n- новое решение → _решения.md, свежее сверху\n- не знаешь куда → _входящее/`\n      },\n      active: {\n        title: \"_делаем.md\",\n        subtitle: \"что в работе сейчас\",\n        why: \"Что по объекту в работе прямо сейчас. Сделанное и подтверждённое удаляется, поэтому файл не превращается в архив.\",\n        inside: [\n          [\"Повестка ближайшей встречи\", \"дата и пункты\"],\n          [\"Задачи по ответственным\", \"у каждой следующий шаг и срок; нет ответственного — раздел «Не назначено»\"],\n          [\"Открытые вопросы\", \"что ещё не решено\"]\n        ],\n        notes: [[\"Чего здесь нет\", \"Идей без следующего шага — они в планах; сделанного — оно в хронике.\"]],\n        sample: `# Дом на 24 квартиры — что делаем\n\n## ❇️ Повестка ближайшей встречи\n**Дата:** 2026-09-22\n- Приёмка пятого этажа\n- График бетонных работ на октябрь\n\n## ✅ Задачи\n### Прораб\n- [ ] Залить перекрытие пятого этажа — до 2026-09-30\n### Руководитель проекта\n- [ ] Согласовать с заказчиком перенос окон на весну — до 2026-09-25\n### Не назначено\n- [ ] Найти резервную бригаду на ноябрь\n\n## ⁉️ Открытые вопросы\n- [ ] Греть бетон зимой или остановить работы на январь — решения нет`\n      },\n      backlog: {\n        title: \"_планы.md\",\n        subtitle: \"что дальше\",\n        why: \"Важное, но не сейчас: то, к чему вернёмся после текущего цикла. Разгружает «делаем», чтобы будущее не смешивалось с текущим фокусом.\",\n        inside: [\n          [\"План\", \"задачи и проекты на потом, по вехам или темам\"],\n          [\"Идеи и гипотезы\", \"что ещё надо обдумать; в строке указаны источник и дата\"]\n        ],\n        notes: [[\"Правило\", \"Что взяли в работу, переносим в «делаем».\"]],\n        sample: `# Дом на 24 квартиры — планы\n\n## 🚩 План\n### Отделка\n- [ ] Выбрать подрядчика на чистовую отделку\n- [ ] Заказать двери и сантехнику\n### Сдача\n- [ ] Собрать пакет документов для комиссии\n\n## ❇️ Идеи и гипотезы\n- [ ] Сдавать квартиры с ремонтом под ключ — заказчик, 2026-09-10`\n      },\n      decisions: {\n        title: \"_решения.md\",\n        subtitle: \"что решили и почему\",\n        why: \"Что приняли, кто и почему. Через три месяца это единственное место, где сохранился мотив выбора.\",\n        inside: \"Записи, свежие сверху. В каждой записи — решение, кто принял, почему и альтернативы, если их обсуждали. Решение без «почему» — половина записи.\",\n        notes: [[\"Чего здесь нет\", \"Задач, планов и идей. Обсуждение, в котором ещё не выбрали, — открытый вопрос в «делаем».\"]],\n        sample: `# Дом на 24 квартиры — решения\n\n## 2026-09-15: Меняем поставщика арматуры\n**Решение:** с октября арматуру берём у второго поставщика.\n**Кто принял:** руководитель проекта\n**Почему:** две поставки подряд опоздали на неделю, стройка стояла.\n**Альтернативы:** оставить прежнего и держать запас на складе.`\n      },\n      progress: {\n        title: \"_хроника.md\",\n        subtitle: \"что было\",\n        why: \"Как двигался объект: что реально изменилось на пути к цели. По хронике видно движение за неделю, квартал и всю историю, не читая встреч.\",\n        inside: \"Записи, свежие сверху; одна запись — один результат: «фундамент», «первый этаж». Заголовок — период и результат, под ним строки: дата, что сдвинулось, источник.\",\n        notes: [[\"Чего здесь нет\", \"Работы над файлами, встреч, которые ничего не сдвинули, и мотивов решений.\"]],\n        sample: `## 2026-03-09 – 2026-03-24 · Первый этаж\n- 2026-03-09 — бригада поставила рекорд кладки за смену. (переписка)\n- 2026-03-12 — стены первого этажа выведены. [Саммари встречи](_встречи/2026-03-12_встреча/саммари.md)\n- 2026-03-24 — перекрытие уложено, этаж готов на неделю раньше графика. [Саммари встречи](_встречи/2026-03-24_встреча/саммари.md)\n\n## 2026-03-02 · Фундамент\n- 2026-03-02 — фундамент залит и принят без замечаний. [Саммари встречи](_встречи/2026-03-02_встреча/саммари.md)`\n      },\n      profile: {\n        title: \"Профиль сотрудника\",\n        subtitle: \"имя-фамилия.md или профиль.md в папке сотрудника\",\n        why: \"Кто человек и за что отвечает. По профилю агент понимает, с кем говорит, какую часть пространства открывать первой и как предлагать решения.\",\n        inside: [\n          [\"Кто я\", \"4–6 предложений: бэкграунд, роль, экспертиза\"],\n          [\"Роль и зона ответственности\", \"должность и за что отвечаю; в шапке — папки моей зоны\"],\n          [\"Ценности и смыслы\", \"миссия, принципы, красные линии\"],\n          [\"Цели и видение\", \"картина на 3–5 лет и фокус на год\"],\n          [\"Зачем мне эта работа\", \"\"],\n          [\"Как думаю и работаю\", \"в чём силён, слепые зоны, как принимаю решения\"],\n          [\"Контекст\", \"другие проекты, ключевые люди, время\"]\n        ],\n        notes: [[\"Кто заполняет\", \"Профиль заполняет сам сотрудник от первого лица; агент помогает сформулировать.\"]],\n        sample: `---\ntitle: \"Анна Смирнова — профиль\"\nrole: \"руководитель отдела продаж\"\nunits: [продажи]\n---\n\n## ❇️ Кто я\nАнна, 38 лет. 10 лет в B2B-продажах стройматериалов, последние 4 года руковожу отделом.\n\n## 🎯 Роль и зона ответственности\nРуководитель отдела продаж → [Продажи](../../продажи/_вводная.md). Отвечаю за выручку отдела и проект выхода на застройщиков.\n\n## ❇️ Ценности и смыслы\n**Принципы:** честно с клиентом — не обещаю сроков, которых не держим.\n\n## 🎯 Цели и видение\n**Фокус на год:** вырастить в отделе двух сильных менеджеров.`\n      }\n    };\n    const helpByLabel = { \"README.md\": \"readme\", \"_вводная.md\": \"overview\", \"_делаем.md\": \"active\", \"_планы.md\": \"backlog\", \"_решения.md\": \"decisions\", \"_хроника.md\": \"progress\" };\n\n    const state = {\n      selectedId: \"root\",\n      explicitUnitParentId: null,\n      renaming: false,\n      showService: false,\n      controlGroups: { aspects: false, kit: false, infrastructure: false, workspace: false },\n      nodes: {}\n    };\n\n    const treeEl = document.getElementById(\"tree\");\n    const selectedInfoEl = document.getElementById(\"selected-info\");\n    const actionsEl = document.getElementById(\"node-actions\");\n    const actionContextEl = document.getElementById(\"action-context\");\n    const unitContextEl = document.getElementById(\"unit-context\");\n    const unitInput = document.getElementById(\"unit-name\");\n    const addUnitButton = document.getElementById(\"add-unit\");\n    const copyButton = document.getElementById(\"copy-tree\");\n    const downloadMarkdownButton = document.getElementById(\"download-markdown\");\n    const showServiceInput = document.getElementById(\"show-service\");\n    const helpOverlayEl = document.getElementById(\"help-overlay\");\n    const helpTitleEl = document.getElementById(\"help-title\");\n    const helpSubtitleEl = document.getElementById(\"help-subtitle\");\n    const helpBodyEl = document.getElementById(\"help-body\");\n\n    function addNode(id, parentId, data) {\n      const parent = parentId ? state.nodes[parentId] : null;\n      const path = data.path || (parent ? `${parent.path}${data.label}` : data.label);\n      state.nodes[id] = {\n        id,\n        type: data.type || \"file\",\n        path,\n        label: data.label,\n        note: data.note || \"\",\n        role: data.role || \"root\",\n        locked: Boolean(data.locked),\n        fixedName: Boolean(data.fixedName),\n        placeholder: Boolean(data.placeholder),\n        proposed: Boolean(data.proposed),\n        acceptsBlocks: Boolean(data.acceptsBlocks),\n        projectContainer: Boolean(data.projectContainer),\n        clientContainer: Boolean(data.clientContainer),\n        open: Boolean(data.open),\n        template: data.template || null, viewKind: data.viewKind || null,\n        children: []\n      };\n      if (parent) parent.children.push(id);\n      return state.nodes[id];\n    }\n\n    \n\n    function slugify(value) {\n      return value.normalize(\"NFC\").trim().toLowerCase().replace(/ё/g, \"е\").replace(/\\.md$/i, \"\").replace(/[^a-z0-9а-я_-]+/gi, \"-\").replace(/^-+|-+$/g, \"\");\n    }\n\n    // `_` и `00_` — наши знаки, имена обзорных файлов заняты: своё имя клиента их не использует.\n    // Латиница и кириллица в одном слове не смешиваются: «o» и «о» выглядят одинаково.\n    function isReservedName(slug) {\n      return /^(_|00_)/.test(slug) || /^(вводная|делаем|планы|решения|хроника)$/.test(slug)\n        || slug.split(/[-_]/).some((word) => /[a-z]/.test(word) && /[а-я]/.test(word));\n    }\n\n    function getNode(id) { return state.nodes[id]; }\n\n    function findParentId(childId) {\n      const parent = Object.values(state.nodes).find((node) => node.children.includes(childId));\n      return parent ? parent.id : null;\n    }\n\n    function isUnitNode(node) {\n      return Boolean(node && node.type === \"folder\" && !(viewBase?.overview && node.locked) && (node.role === \"unit\" || node.acceptsBlocks));\n    }\n\n    function getUnitParent() {\n      const explicitParent = getNode(state.explicitUnitParentId);\n      return isUnitNode(explicitParent) ? explicitParent : getNode(\"root\");\n    }\n\n    function getActionTarget() {\n      let current = getNode(state.selectedId);\n      while (current) {\n        if (isUnitNode(current)) return current;\n        current = getNode(findParentId(current.id));\n      }\n      return null;\n    }\n\n    function uniqueId(prefix) {\n      let index = 1;\n      while (state.nodes[`${prefix}-${index}`]) index += 1;\n      return `${prefix}-${index}`;\n    }\n\n    function addPresetFile(parent, suffix, label, note, role, placeholder = false, proposed = false) {\n      return addNode(uniqueId(`${parent.id}-${suffix}`), parent.id, { label, note, role, placeholder, proposed, template: viewTemplate(parent, label) });\n    }\n\n    function addPresetFolder(parent, suffix, label, note, role, options = {}) {\n      if (options.placeholder) label = freeFolderLabel(parent, label);\n      return addNode(uniqueId(`${parent.id}-${suffix}`), parent.id, { type: \"folder\", label, note, role, viewKind: suffix === 'project' ? 'project' : suffix === 'client' ? 'client' : null, ...options });\n    }\n\n    function applyUnitPreset(node, slug) {\n      node.viewKind = slug === \"клиенты\" ? \"clients\" : slug === \"продукт\" ? \"product\" : \"unit\";\n      if (slug === \"клиенты\") {\n        node.note = \"портфель клиентов как отдельный объект управления\";\n        node.clientContainer = true;\n        addPresetFile(node, \"readme\", \"README.md\", \"карта клиентского портфеля\", \"unit\");\n        addPresetFile(node, \"overview\", \"_вводная.md\", \"что это, кто отвечает, куда идёт\", \"kit\");\n        addClient(node.id);\n        return;\n      }\n      addPresetFile(node, \"readme\", \"README.md\", \"карта объекта управления\", \"unit\");\n      addPresetFile(node, \"overview\", \"_вводная.md\", \"что это, кто отвечает, куда идёт\", \"kit\");\n      if (slug === \"продукт\") {\n        node.note = \"продукт как самостоятельный объект управления\";\n        addPresetFile(node, \"passport\", \"паспорт.md\", \"что это по сути: паспорт продукта\", \"unit\");\n      }\n    }\n\n    function addUnit(rawName) {\n      const slug = slugify(rawName);\n      if (!slug) return;\n      if (isReservedName(slug)) {\n        unitContextEl.textContent = \"Имя не подходит: «_», «00_» и имена обзорных файлов заняты, латиницу с кириллицей в слове не смешиваем\";\n        return;\n      }\n      const parent = getUnitParent();\n      const label = `${slug}/`;\n      if (parent.children.some((id) => getNode(id).label === label)) return;\n      const node = addNode(uniqueId(`unit-${slug}`), parent.id, {\n        type: \"folder\", label, note: \"объект управления клиента\", role: \"unit\", acceptsBlocks: true, fixedName: false, open: true\n      });\n      applyUnitPreset(node, slug);\n      parent.open = true;\n      if (slug !== \"клиенты\") {\n        state.selectedId = node.id;\n        state.renaming = false;\n      }\n      state.explicitUnitParentId = null;\n      unitInput.value = \"\";\n      render();\n    }\n\n    function addBlockPreset(node, block, parent) {\n      if (block.kind !== \"folder\") return;\n      if (block.id === \"strategic\") {\n        addPresetFile(node, \"vision\", \"видение.md\", \"кто мы и зачем: миссия, образ будущего, ценности\", \"aspect\");\n        addPresetFile(node, \"goal\", \"цели.md\", \"куда идём и к какому сроку\", \"aspect\");\n        addPresetFile(node, \"strategy\", \"стратегия.md\", \"за счёт каких выборов идём\", \"aspect\");\n      } else if (block.id === \"team\") {\n        addPresetFile(node, \"org\", \"оргструктура.md\", \"кто за что отвечает и кто кому подчиняется\", \"aspect\");\n        addPresetFile(node, \"employee\", \"имя-фамилия.md\", \"профиль сотрудника — переименовать\", \"aspect\", true).help = \"profile\";\n      } else if (block.id === \"metrics\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта показателей\", \"aspect\");\n        addPresetFile(node, \"domain\", \"показатели-направления.md\", \"показатели одного направления — переименовать: продаж, маркетинга…\", \"aspect\", true);\n        const source = addPresetFolder(node, \"source\", \"источники/\", \"удалить, если локальных таблиц и выгрузок нет\", \"infrastructure\", { proposed: true });\n        addPresetFile(source, \"readme\", \"README.md\", \"миссия папки источников\", \"infrastructure\");\n        const extractors = addPresetFolder(node, \"extractors\", \"extractors/\", \"удалить, если извлечение не нужно\", \"infrastructure\", { proposed: true });\n        addPresetFile(extractors, \"readme\", \"README.md\", \"миссия кода извлечения\", \"infrastructure\");\n      } else if (block.id === \"finance\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта финансов\", \"aspect\");\n      } else if (block.id === \"projects\") {\n        node.projectContainer = true;\n        addPresetFile(node, \"readme\", \"README.md\", \"карта проектов\", \"aspect\");\n        addProject(node.id);\n      } else if (block.id === \"processes\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта процессов\", \"aspect\");\n        addPresetFile(node, \"process\", \"название-процесса.md\", \"один процесс — переименовать\", \"aspect\", true);\n      } else if (block.id === \"knowledge\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта базы знаний\", \"workspace\");\n        addPresetFile(node, \"topic\", \"тема.md\", \"одна тема — переименовать\", \"workspace\", true);\n      } else if (block.id === \"meetings\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"карта встреч\", \"infrastructure\");\n      } else if (block.id === \"inbox\" || block.id === \"archive\") {\n        addPresetFile(node, \"readme\", \"README.md\", \"миссия служебной папки\", \"infrastructure\");\n      }\n    }\n\n    function addEmployeeWithPrivate(unit) {\n      // Личное — только `_личное/` в папке сотрудника в `00_команда/`.\n      let team = unit.children.map(getNode).find(child => child.label === \"00_команда/\");\n      if (!team) {\n        const block = blockCatalog.aspects.find(item => item.id === \"team\");\n        team = addNode(uniqueId(`${unit.id}-team`), unit.id, { type: \"folder\", label: \"00_команда/\", note: block.description, role: \"aspect\", open: true });\n        addPresetFile(team, \"org\", \"оргструктура.md\", \"кто за что отвечает и кто кому подчиняется\", \"aspect\");\n      }\n      let label = \"имя-фамилия/\", index = 2;\n      while (team.children.some(id => getNode(id).label === label)) label = \"имя-фамилия-\" + index++ + \"/\";\n      const person = addPresetFolder(team, \"employee\", label, \"папка сотрудника — переименовать в имя-фамилию\", \"workspace\", { placeholder: true, open: true, viewKind: \"employee\" });\n      addPresetFile(person, \"readme\", \"README.md\", \"карта папки сотрудника\", \"workspace\");\n      addPresetFile(person, \"profile\", \"профиль.md\", \"профиль: роль и зона ответственности\", \"workspace\").help = \"profile\";\n      addPresetFolder(person, \"private\", \"_личное/\", \"видит только сотрудник и его агент; права настроить до размещения\", \"infrastructure\");\n      team.open = true; unit.open = true;\n      state.selectedId = person.id;\n      state.renaming = true;\n      render();\n    }\n\n    function addBlock(block) {\n      const parent = getActionTarget();\n      // Добавленная служебная папка не должна пропасть с глаз.\n      if (parent && block.role === \"infrastructure\") state.showService = true;\n      if (parent && block.id === \"private\") return addEmployeeWithPrivate(parent);\n      if (!parent || parent.children.some((id) => getNode(id).label === block.path)) return;\n      const node = addNode(uniqueId(`${parent.id}-${block.id}`), parent.id, {\n        type: block.kind, label: block.path, note: block.description, role: block.role, placeholder: Boolean(block.placeholder), open: true, template: block.kind === \"folder\" ? null : viewTemplate(parent, block.path)\n      });\n      addBlockPreset(node, block, parent);\n      parent.open = true;\n      if (block.id !== \"projects\") {\n        state.selectedId = node.id;\n        state.renaming = false;\n      }\n      render();\n    }\n\n    function addProject(containerId) {\n      const container = getNode(containerId);\n      if (!container) return;\n      const project = addPresetFolder(container, \"project\", \"название-проекта/\", \"проект — переименовать\", \"unit\", { acceptsBlocks: true, placeholder: true, open: true });\n      addPresetFile(project, \"readme\", \"README.md\", \"карта проекта\", \"unit\");\n      addPresetFile(project, \"overview\", \"_вводная.md\", \"что за проект, кто отвечает, на какую цель работает\", \"kit\");\n      state.selectedId = project.id;\n      state.renaming = true;\n    }\n\n    function addClient(containerId) {\n      const container = getNode(containerId);\n      if (!container) return;\n      const client = addPresetFolder(container, \"client\", \"название-клиента/\", \"клиент — переименовать\", \"unit\", { acceptsBlocks: true, placeholder: true, open: true });\n      addPresetFile(client, \"readme\", \"README.md\", \"карта папки клиента\", \"unit\");\n      addPresetFile(client, \"overview\", \"_вводная.md\", \"что за клиент, кто отвечает, куда идём с ним\", \"kit\");\n      addPresetFile(client, \"company\", \"компания.md\", \"бизнес клиента\", \"unit\");\n      addPresetFile(client, \"people\", \"люди.md\", \"ключевые люди клиента\", \"unit\");\n      state.selectedId = client.id;\n      state.renaming = true;\n    }\n\n    function addOwnFolder(parent) {\n      if (!parent) return;\n      let label = \"новая-папка/\", index = 2;\n      while (parent.children.some((id) => getNode(id).label === label)) label = `новая-папка-${index++}/`;\n      const folder = addPresetFolder(parent, \"own\", label, \"ваша папка\", \"workspace\", { placeholder: true, open: true });\n      parent.open = true;\n      state.selectedId = folder.id;\n      state.renaming = true;\n      render();\n    }\n\n    function setShowService(value) {\n      state.showService = value;\n      if (value) return;\n      // Выбранное внутри скрытой служебной папки — выбор переходит к ближайшей видимой папке.\n      let id = state.selectedId;\n      for (let current = id; current; current = findParentId(current)) {\n        if (getNode(current).role === \"infrastructure\") id = findParentId(current);\n      }\n      if (id !== state.selectedId) {\n        state.selectedId = id;\n        state.renaming = false;\n      }\n    }\n\n    function helpKey(node) {\n      if (!node || node.type !== \"file\") return null;\n      const key = node.help || helpByLabel[node.label];\n      return helpCatalog[key] ? key : null;\n    }\n\n    function openHelp(key) {\n      const help = helpCatalog[key];\n      if (!help) return;\n      helpTitleEl.textContent = help.title;\n      helpSubtitleEl.textContent = help.subtitle;\n      helpBodyEl.innerHTML = \"\";\n      const text = document.createElement(\"div\");\n      text.className = \"help-text\";\n      const section = (heading, content) => {\n        const block = document.createElement(\"div\");\n        const title = document.createElement(\"h3\");\n        title.textContent = heading;\n        block.append(title, content);\n        text.appendChild(block);\n      };\n      const paragraph = (value) => { const p = document.createElement(\"p\"); p.textContent = value; return p; };\n      section(\"Зачем\", paragraph(help.why));\n      if (Array.isArray(help.inside)) {\n        const list = document.createElement(\"ul\");\n        help.inside.forEach(([term, value]) => {\n          const item = document.createElement(\"li\");\n          const bold = document.createElement(\"b\");\n          bold.textContent = term;\n          item.append(bold);\n          if (value) item.append(` — ${value}`);\n          list.appendChild(item);\n        });\n        section(\"Что внутри\", list);\n      } else {\n        section(\"Что внутри\", paragraph(help.inside));\n      }\n      (help.notes || []).forEach(([heading, value]) => section(heading, paragraph(value)));\n      const sampleBlock = document.createElement(\"div\");\n      const sampleTitle = document.createElement(\"h3\");\n      sampleTitle.textContent = \"Как выглядит\";\n      const sample = document.createElement(\"div\");\n      sample.className = \"help-sample\";\n      sample.innerHTML = renderMarkdown(help.sample);\n      sampleBlock.append(sampleTitle, sample);\n      helpBodyEl.append(text, sampleBlock);\n      helpOverlayEl.hidden = false;\n      helpOverlayEl.querySelector(\"[data-help-close]\").focus();\n    }\n\n    function closeHelp() { helpOverlayEl.hidden = true; }\n\n    // Образец справки — Markdown в отрисованном виде: заголовки, списки, задачи, таблица, шапка файла.\n    function escapeHtml(value) {\n      return value.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\n    }\n\n    function inlineMarkdown(value) {\n      return escapeHtml(value)\n        .replace(/\\*\\*(.+?)\\*\\*/g, \"<b>$1</b>\")\n        .replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, '<span class=\"md-link\" title=\"$2\">$1</span>');\n    }\n\n    function renderMarkdown(source) {\n      const lines = source.split(\"\\n\");\n      const html = [];\n      let i = 0;\n      if (lines[0] === \"---\") {\n        const end = lines.indexOf(\"---\", 1);\n        html.push(`<div class=\"md-meta\">${lines.slice(1, end).map((line) => `<div>${escapeHtml(line)}</div>`).join(\"\")}</div>`);\n        i = end + 1;\n      }\n      const cells = (row) => row.slice(1, -1).split(\"|\").map((cell) => cell.trim());\n      while (i < lines.length) {\n        const line = lines[i];\n        const heading = line.match(/^(#{1,3}) (.*)$/);\n        if (!line.trim()) {\n          i += 1;\n        } else if (heading) {\n          html.push(`<div class=\"md-h md-h${heading[1].length}\">${inlineMarkdown(heading[2])}</div>`);\n          i += 1;\n        } else if (line.startsWith(\"|\")) {\n          const rows = [];\n          while (i < lines.length && lines[i].startsWith(\"|\")) rows.push(lines[i++]);\n          const [head, , ...body] = rows;\n          html.push(`<table class=\"md-table\"><thead><tr>${cells(head).map((cell) => `<th>${inlineMarkdown(cell)}</th>`).join(\"\")}</tr></thead><tbody>${body.map((row) => `<tr>${cells(row).map((cell) => `<td>${inlineMarkdown(cell)}</td>`).join(\"\")}</tr>`).join(\"\")}</tbody></table>`);\n        } else if (line.startsWith(\"- \")) {\n          const items = [];\n          while (i < lines.length && lines[i].startsWith(\"- \")) items.push(lines[i++].slice(2));\n          html.push(`<ul class=\"md-list\">${items.map((item) => {\n            const task = item.match(/^\\[ \\] (.*)$/);\n            return task ? `<li class=\"md-task\"><span class=\"md-box\"></span><span>${inlineMarkdown(task[1])}</span></li>` : `<li>${inlineMarkdown(item)}</li>`;\n          }).join(\"\")}</ul>`);\n        } else {\n          const paragraph = [];\n          while (i < lines.length && lines[i].trim() && !/^(#{1,3} |\\||- )/.test(lines[i])) paragraph.push(lines[i++]);\n          html.push(`<p class=\"md-p\">${paragraph.map(inlineMarkdown).join(\"<br>\")}</p>`);\n        }\n      }\n      return html.join(\"\");\n    }\n\n    function selectNode(id) {\n      if (!getNode(id)) return;\n      state.selectedId = id;\n      state.explicitUnitParentId = isUnitNode(getNode(id)) ? id : null;\n      state.renaming = false;\n      render();\n    }\n\n    function deleteSubtree(id) {\n      const node = getNode(id);\n      if (!node) return;\n      node.children.slice().forEach(deleteSubtree);\n      delete state.nodes[id];\n    }\n\n    function removeSelected() {\n      const node = getNode(state.selectedId);\n      if (viewReadOnly || !node || node.locked || (viewBase?.overview && hasLockedDescendant(node))) return;\n      const parentId = findParentId(node.id) || \"root\";\n      const parent = getNode(parentId);\n      parent.children = parent.children.filter((id) => id !== node.id);\n      deleteSubtree(node.id);\n      state.selectedId = parentId;\n      state.renaming = false;\n      render();\n    }\n\n    function updateSubtreePaths(node, oldPath, newPath) {\n      node.path = newPath;\n      node.children.forEach((id) => {\n        const child = getNode(id);\n        updateSubtreePaths(child, oldPath, child.path.replace(oldPath, newPath));\n      });\n    }\n\n    function canRenameNode(node) {\n      return Boolean(!viewReadOnly && node && !node.locked && !node.fixedName && !(viewBase?.overview && hasLockedDescendant(node)) && (node.placeholder || (node.type === \"folder\" && (node.role === \"unit\" || node.role === \"workspace\"))));\n    }\n\n    function renameNode(id, rawName) {\n      const node = getNode(id);\n      if (!canRenameNode(node)) return false;\n      const slug = slugify(rawName);\n      if (!slug || isReservedName(slug)) return false;\n      const parent = getNode(findParentId(id));\n      const label = node.type === \"folder\" ? `${slug}/` : `${slug}.md`;\n      if (parent.children.some((childId) => childId !== id && getNode(childId).label === label)) return false;\n      const oldPath = node.path;\n      const newPath = `${parent.path}${label}`;\n      node.label = label;\n      node.placeholder = false;\n      updateSubtreePaths(node, oldPath, newPath);\n      state.renaming = false;\n      render();\n      return true;\n    }\n\n    function roleLabel(role) {\n      return ({ unit: \"объект\", aspect: \"управление\", kit: \"обзор\", infrastructure: \"служебное\", workspace: \"ваше\" })[role] || \"папка\";\n    }\n\n    function orderedChildren(node) {\n      return node.children.slice().sort((a, b) => {\n        const left = getNode(a);\n        const right = getNode(b);\n        if (left.type !== right.type) return left.type === \"folder\" ? -1 : 1;\n        return left.label.localeCompare(right.label, \"en\", { numeric: true });\n      });\n    }\n\n    function renderNode(id) {\n      const node = getNode(id);\n      const selected = node.id === state.selectedId ? \" selected\" : \"\";\n      const nameClass = node.placeholder ? \"template-name\" : \"\";\n      const purpose = customPurpose(node);\n      const collection = node.note.match(/Содержимое: папок — \\d+, файлов — \\d+\\./)?.[0];\n      const unloaded = node.note.startsWith('Не загружено.');\n      const unloadedHint = viewCanExpand && !viewReadOnly ? 'Нажмите стрелку, чтобы загрузить содержимое' : 'Попросите агента раскрыть папку';\n      const note = purpose ? ` <span class=\"custom-purpose\">${escapeHtml(purpose)}</span>` : viewBase?.overview ? (unloaded ? ` <span class=\"muted\">${unloadedHint}</span>` : '') : node.note ? ` <span class=\"muted\">${node.proposed ? \"предлагается · \" : \"\"}${escapeHtml(node.note)}</span>` : \"\";\n      const kind = node.role === \"root\" ? (node.id !== \"root\" ? '<span class=\"kind\">роль не определена</span>' : \"\") : `<span class=\"kind ${purpose ? \"custom\" : node.role}\">${purpose ? \"рабочий документ\" : roleLabel(node.role)}</span>`;\n      if (node.type === \"folder\") {\n        const details = document.createElement(\"details\");\n        details.className = \"folder\";\n        details.open = node.open;\n        details.innerHTML = `<summary class=\"${selected}\" data-id=\"${node.id}\"><span class=\"marker\" data-toggle></span>${kind}<span class=\"${nameClass}\">${escapeHtml(node.label)}</span>${note}</summary>`;\n        const summary = details.querySelector(\"summary\");\n        summary.addEventListener(\"click\", (event) => {\n          event.preventDefault();\n          if (event.target.closest(\"[data-toggle]\")) {\n            node.open = !details.open; details.open = node.open; viewPublishUi();\n            if (node.open && unloaded && viewCanExpand && !viewReadOnly) parent.postMessage({type:'view-expand', nodeId:node.id}, '*');\n          }\n          else selectNode(node.id);\n        });\n        const children = document.createElement(\"div\");\n        children.className = \"children\";\n        orderedChildren(node)\n          .filter((childId) => !technicalNode(getNode(childId)) && (state.showService || getNode(childId).role !== \"infrastructure\"))\n          .forEach((childId) => children.appendChild(renderNode(childId)));\n        if (collection) { const line = document.createElement('p'); line.className = 'muted'; line.textContent = collection; children.appendChild(line); }\n        if (unloaded && (!viewCanExpand || viewReadOnly)) { const hint = document.createElement('p'); hint.className = 'muted'; hint.textContent = 'Содержимое папки можно посмотреть. Попросите агента раскрыть её.'; children.appendChild(hint); }\n        details.appendChild(children);\n        details.addEventListener(\"toggle\", () => { node.open = details.open; viewPublishUi(); });\n        return details;\n      }\n      const file = document.createElement(\"div\");\n      file.className = `file${selected}`;\n      file.dataset.id = node.id;\n      const help = helpKey(node);\n      const helpDot = help ? '<span class=\"help-dot\" data-help title=\"Подробнее о файле\">?</span>' : \"\";\n      file.innerHTML = `${kind}<span class=\"${nameClass}\">${escapeHtml(node.label)}</span>${helpDot}${note}`;\n      file.addEventListener(\"click\", (event) => {\n        selectNode(node.id);\n        if (help && event.target.closest(\"[data-help]\")) openHelp(help);\n      });\n      return file;\n    }\n\n    function renderTree() {\n      treeEl.innerHTML = \"\";\n      treeEl.appendChild(renderNode(\"root\"));\n    }\n\n    function renderInfo() {\n      const node = getNode(state.selectedId);\n      if (!node) return;\n      const canDelete = !viewReadOnly && !node.locked && !(viewBase?.overview && hasLockedDescendant(node));\n      const canRename = canRenameNode(node);\n      if (state.renaming && canRename) {\n        const value = node.label.replace(/\\/$/, \"\").replace(/\\.md$/, \"\");\n        selectedInfoEl.innerHTML = `<div class=\"info-top\"><input id=\"rename-input\" type=\"text\" value=\"${escapeHtml(value)}\"></div><div style=\"display:flex;gap:8px;margin-top:10px\"><button type=\"button\" data-rename-save>Сохранить</button><button class=\"secondary\" type=\"button\" data-rename-cancel>Отмена</button></div><p class=\"muted\" data-rename-error style=\"margin-top:6px\"></p>`;\n        const input = selectedInfoEl.querySelector(\"#rename-input\");\n        const error = selectedInfoEl.querySelector(\"[data-rename-error]\");\n        const save = () => { if (!renameNode(node.id, input.value)) error.textContent = \"Введите свободное имя: «_», «00_» и имена обзорных файлов заняты, латиницу с кириллицей в слове не смешиваем\"; };\n        input.focus(); input.select();\n        selectedInfoEl.querySelector(\"[data-rename-save]\").addEventListener(\"click\", save);\n        selectedInfoEl.querySelector(\"[data-rename-cancel]\").addEventListener(\"click\", () => { state.renaming = false; renderInfo(); });\n        input.addEventListener(\"keydown\", (event) => { if (event.key === \"Enter\") save(); if (event.key === \"Escape\") { state.renaming = false; renderInfo(); } });\n        return;\n      }\n      const help = helpKey(node);\n      selectedInfoEl.innerHTML = `<div class=\"info-top\"><strong class=\"selected-name\" title=\"${escapeHtml(node.label)}\">${escapeHtml(node.label)}</strong><div class=\"selected-actions\">${help ? '<button type=\"button\" data-help-selected>Подробнее</button>' : \"\"}${canRename ? '<button class=\"secondary\" type=\"button\" data-rename-selected>Переименовать</button>' : \"\"}${canDelete ? '<button class=\"danger\" type=\"button\" data-remove-selected>Удалить</button>' : \"\"}</div></div>`;\n      selectedInfoEl.querySelector(\"[data-help-selected]\")?.addEventListener(\"click\", () => openHelp(help));\n      selectedInfoEl.querySelector(\"[data-rename-selected]\")?.addEventListener(\"click\", () => { state.renaming = true; renderInfo(); });\n      selectedInfoEl.querySelector(\"[data-remove-selected]\")?.addEventListener(\"click\", removeSelected);\n      if (viewBase?.overview && node.note) {\n        const reason = document.createElement('p'); reason.className = 'muted'; reason.textContent = node.note; selectedInfoEl.appendChild(reason);\n      }\n    }\n\n    function renderActions() {\n      const selected = getNode(state.selectedId);\n      const target = getActionTarget();\n      actionsEl.innerHTML = \"\";\n      if (viewReadOnly) return;\n      if (viewBase?.overview && selected?.locked) {\n        actionContextEl.textContent = \"Папка не раскрыта: добавление недоступно.\";\n        return;\n      }\n      if (selected?.projectContainer) {\n        const button = document.createElement(\"button\"); button.type = \"button\"; button.textContent = \"+ Добавить проект\";\n        button.addEventListener(\"click\", () => { addProject(selected.id); render(); }); actionsEl.appendChild(button);\n      }\n      if (selected?.clientContainer) {\n        const button = document.createElement(\"button\"); button.type = \"button\"; button.textContent = \"+ Добавить клиента\";\n        button.addEventListener(\"click\", () => { addClient(selected.id); render(); }); actionsEl.appendChild(button);\n      }\n      if (!target) {\n        actionContextEl.textContent = \"Выберите объект управления в дереве.\";\n        return;\n      }\n      actionContextEl.textContent = `Добавляем в: ${target.label}`;\n      const titles = {\n        aspects: [\"ПАПКИ УПРАВЛЕНИЯ\", \"как двигаем к цели\"], kit: [\"ОБЗОРНЫЕ ФАЙЛЫ\", \"доска на входе\"],\n        infrastructure: [\"СЛУЖЕБНЫЕ ПАПКИ\", \"инфраструктура системы\"], workspace: [\"ВАШИ ПАПКИ\", \"рабочие материалы\"]\n      };\n      [\"aspects\", \"kit\", \"infrastructure\", \"workspace\"].forEach((group) => {\n        const details = document.createElement(\"details\"); details.className = \"add-group\"; details.open = state.controlGroups[group];\n        details.innerHTML = `<summary class=\"add-group-title\"><span class=\"axis-head\"><span class=\"axis-title\"><span class=\"axis-dot ${group}\"></span><span class=\"axis-label\">${titles[group][0]}</span><span class=\"axis-subtitle\">${titles[group][1]}</span></span></span><span>${blockCatalog[group].length}</span></summary>`;\n        details.addEventListener(\"toggle\", () => { state.controlGroups[group] = details.open; viewPublishUi(); });\n        const buttons = document.createElement(\"div\"); buttons.className = \"add-buttons\";\n        if (group === \"workspace\") {\n          const own = document.createElement(\"button\"); own.type = \"button\"; own.className = \"secondary\";\n          own.innerHTML = `<span class=\"block-label\">своя папка<span class=\"block-label-ru\">/ назовите сами</span></span><span>+</span>`;\n          own.addEventListener(\"click\", () => addOwnFolder(target)); buttons.appendChild(own);\n        }\n        blockCatalog[group].forEach((block) => {\n          const exists = target.children.some((id) => getNode(id).label === block.path);\n          const button = document.createElement(\"button\"); button.type = \"button\"; button.className = \"secondary\"; button.disabled = exists;\n          button.innerHTML = `<span class=\"block-label\">${block.path}<span class=\"block-label-ru\">/ ${block.labelRu}</span></span><span>${exists ? \"✓\" : \"+\"}</span>`;\n          if (!exists) button.addEventListener(\"click\", () => addBlock(block));\n          buttons.appendChild(button);\n        });\n        details.appendChild(buttons); actionsEl.appendChild(details);\n      });\n    }\n\n    function renderUnitContext() {\n      const parent = getUnitParent();\n      unitContextEl.textContent = parent.id === \"root\" ? \"В корень пространства\" : `Внутрь явно выбранного ${parent.label}`;\n    }\n\n    \n\n    function setAllOpen(value) { Object.values(state.nodes).forEach((node) => { if (node.type === \"folder\") node.open = value; }); render(); }\n    function collapseToRoot() { Object.values(state.nodes).forEach((node) => { if (node.type === \"folder\") node.open = node.id === \"root\"; }); render(); }\n    function focusSelected() {\n      const open = new Set(); let id = state.selectedId;\n      while (id) { open.add(id); id = findParentId(id); }\n      Object.values(state.nodes).forEach((node) => { if (node.type === \"folder\") node.open = open.has(node.id); }); render();\n    }\n\n    // ── Слой View поверх конструктора сайта ─────────────────────────────────\n    // Подключается сборкой (scripts/build-editor.mjs) в конец скрипта конструктора\n    // сайта вместо его начальной инициализации. Функции с тем же именем, что на сайте,\n    // заменяют сайтовые целиком; мелкие добавки View в функции сайта сборка вписывает заменами.\n    const viewTemplates = __VIEW_TEMPLATES__;\n    const viewVisibilityPolicy = __VIEW_VISIBILITY_POLICY__;\n    let viewBase = null, viewLast = '', viewReadOnly = true, viewCanExpand = false;\n    function viewAccess(readOnly) {\n      // Autosave receipts repeat the current permission. Keep the active rename input intact.\n      if (viewBase && viewReadOnly === (readOnly !== false)) return;\n      viewReadOnly = readOnly !== false;\n      document.body.dataset.viewReadonly = String(viewReadOnly);\n      document.querySelector('.control-panel > .panel:not(.accent) h2').textContent = viewReadOnly ? 'Выбранный элемент' : 'Добавить в узел';\n      if (viewReadOnly) state.renaming = false;\n      if (viewBase) { renderInfo(); renderActions(); }\n    }\n    function viewConfig() {\n      return { ...viewBase, tree: Object.values(state.nodes).map(node => ({id:node.id,parentId:findParentId(node.id),name:node.label.replace(/\\/$/,''),type:node.type,note:node.note,role:node.role,locked:node.locked,fixedName:node.fixedName,placeholder:node.placeholder,proposed:node.proposed,acceptsBlocks:node.acceptsBlocks,projectContainer:node.projectContainer,clientContainer:node.clientContainer,template:node.template,viewKind:node.viewKind})) };\n    }\n    function viewPublish() {\n      if (!viewBase || viewReadOnly) return;\n      const config = viewConfig(), json = JSON.stringify(config);\n      if (json !== viewLast) { viewLast = json; parent.postMessage({type:'view-change',config}, '*'); }\n    }\n    function viewPublishUi() {\n      parent.postMessage({ type: 'view-ui', ui: { selectedId: state.selectedId,\n        openIds: Object.values(state.nodes).filter(node => node.type === 'folder' && node.open).map(node => node.id),\n        controlGroups: { ...state.controlGroups } } }, '*');\n    }\n    // Шаблон назван так же, как файл или папка в пространстве: ищем его по имени.\n    // Шаблон узла — по виду узла; остальные — по имени файла или папки вне root/ и nodes/.\n    const VIEW_NODE_DIRS = { employee: 'nodes/employee', product: 'nodes/продукт', clients: 'nodes/клиенты', client: 'nodes/клиенты/client-name', unit: 'nodes/unit', project: 'nodes/unit' };\n    function viewTemplate(parent, label) {\n      const kind = parent.viewKind;\n      const nodeDir = VIEW_NODE_DIRS[kind];\n      if (nodeDir && viewTemplates.includes(`templates/${nodeDir}/${label}`)) return `templates/${nodeDir}/${label}`;\n      if (kind === 'employee' && label === 'профиль.md') return 'templates/aspects/00_команда/имя-фамилия.md';\n      // Заготовки конструктора с именем «переименуй под сущность» ведут к шаблону своего вида.\n      const name = label === 'README.md' ? `${parent.label.replace(/\\/$/, '')}/README.md` : /^показатели-[а-я-]+\\.md$/.test(label) ? 'показатели-направления.md' : /^название-процесса(-\\d+)?\\.md$/.test(label) ? 'процесс.md' : label;\n      return viewTemplates.find(path => !/^templates\\/(root|nodes)\\//.test(path) && path.endsWith('/' + name)) || null;\n    }\n    function freeFolderLabel(parent, label) {\n      const stem = label.replace(/\\/$/, '');\n      const used = new Set(parent.children.map(id => getNode(id).label.replace(/\\/$/, '')));\n      let name = stem;\n      for (let index = 2; used.has(name); index++) name = stem + '-' + index;\n      return name + '/';\n    }\n    function hasLockedDescendant(node) {\n      return node.children.some(id => { const child = getNode(id); return child && (child.locked || hasLockedDescendant(child)); });\n    }\n    function technicalNode(node) {\n      const parts = [node.label.replace(/\\/$/, '')];\n      let parent = getNode(findParentId(node.id));\n      while (parent && parent.id !== 'root') { parts.unshift(parent.label.replace(/\\/$/, '')); parent = getNode(findParentId(parent.id)); }\n      return parts.some((name, index) => name.startsWith('.') && !viewVisibilityPolicy.canonicalDotPaths.includes(parts.slice(0, index + 1).join('/')))\n        || (parts[0] === '.svaib' && viewVisibilityPolicy.serviceMetadata.includes(parts[1]))\n        || parts.some(name => viewVisibilityPolicy.technicalNames.includes(name));\n    }\n    function customPurpose(node) {\n      if (node.role !== 'workspace' || node.type !== 'file') return '';\n      return node.note.match(/Основание: [^\\n]*?README\\.md:\\s*(.+)/)?.[1] || '';\n    }\n    function buildInitialTree(config, ui) {\n      if (!config) return;\n      const previous = state.nodes;\n      state.nodes = Object.create(null);\n      const entries = new Map(config.tree.map(item => [item.id, item]));\n      function insert(item) {\n        if (state.nodes[item.id]) return;\n        if (item.parentId) insert(entries.get(item.parentId));\n        addNode(item.id, item.parentId, { ...item, label: item.name + (item.type === 'folder' ? '/' : ''), open: previous[item.id]?.open ?? (item.parentId === null || item.id === 'company' || item.name === '00_компания') });\n      }\n      config.tree.forEach(insert);\n      if (ui && Array.isArray(ui.openIds)) {\n        const openIds = new Set(ui.openIds);\n        Object.values(state.nodes).forEach(node => { if (node.type === 'folder') node.open = openIds.has(node.id); });\n        if (typeof ui.selectedId === 'string' && state.nodes[ui.selectedId]) state.selectedId = ui.selectedId;\n        if (ui.controlGroups && typeof ui.controlGroups === 'object')\n          Object.keys(state.controlGroups).forEach(key => { if (typeof ui.controlGroups[key] === 'boolean') state.controlGroups[key] = ui.controlGroups[key]; });\n      }\n      const root = config.tree.find(item => item.parentId === null);\n      if (root.id !== 'root') throw new Error('Корневой ID должен быть root.');\n      const overview = Boolean(config.overview);\n      const shownDepth = Math.max(...config.tree.map(item => { let depth = 0, parentId = item.parentId; while (parentId) { depth++; parentId = config.tree.find(parent => parent.id === parentId)?.parentId; } return depth; }));\n      const unread = config.tree.filter(item => item.note.startsWith('Не загружено.')).length;\n      document.getElementById('tree-description').textContent = overview ? `Снимок папки: ${config.overview.capturedAt ? new Date(config.overview.capturedAt).toLocaleString('ru-RU') : 'дата чтения неизвестна'}. Показано уровней: ${shownDepth}. Ещё не загружено веток: ${unread}. Раскрой папку, чтобы посмотреть её содержимое.` : 'Обязательная основа уже показана. Остальное добавляется по выбору.';\n      document.getElementById('tree-mode').textContent = overview ? 'частичный обзор' : 'базовая структура';\n      if (!state.nodes[state.selectedId]) state.selectedId = 'root';\n      if (!state.nodes[state.explicitUnitParentId]) state.explicitUnitParentId = null;\n      viewBase = { schemaVersion: 2, catalogVersion: config.catalogVersion, canonSnapshot: config.canonSnapshot, companyName: config.companyName, ...(config.overview ? {overview: config.overview} : {}) };\n      viewLast = JSON.stringify(viewConfig());\n      render();\n    }\n    let renderedTreeSignature = '';\n    function render() {\n      showServiceInput.checked = state.showService;\n      const signature = JSON.stringify([state.showService, Object.values(state.nodes).map(({open, ...node}) => node)]);\n      if (signature !== renderedTreeSignature) { renderTree(); renderedTreeSignature = signature; }\n      else {\n        treeEl.querySelectorAll('[data-id]').forEach(element => element.classList.toggle('selected', element.dataset.id === state.selectedId));\n        treeEl.querySelectorAll('details.folder').forEach(details => { const node = getNode(details.querySelector('summary')?.dataset.id); if (node) details.open = node.open; });\n      }\n      renderInfo(); renderActions(); renderUnitContext(); viewPublish(); viewPublishUi();\n    }\n    let viewHeight = 0, viewResizeFrame = 0;\n    function viewResize() {\n      cancelAnimationFrame(viewResizeFrame);\n      viewResizeFrame = requestAnimationFrame(() => {\n        // Measure content, never viewport/scrollHeight: iframe height must not feed back into itself.\n        const height = Math.ceil(document.querySelector('.page').getBoundingClientRect().bottom + scrollY);\n        if (height !== viewHeight) { viewHeight = height; parent.postMessage({type:'view-resize',height}, '*'); }\n      });\n    }\n\n    addUnitButton.addEventListener(\"click\", () => addUnit(unitInput.value));\n    unitInput.addEventListener(\"keydown\", (event) => { if (event.key === \"Enter\") addUnit(unitInput.value); });\n    document.querySelectorAll(\"[data-quick-unit]\").forEach((button) => button.addEventListener(\"click\", () => addUnit(button.dataset.quickUnit)));\n    document.querySelector(\"[data-action='expand']\").addEventListener(\"click\", () => setAllOpen(true));\n    document.querySelector(\"[data-action='collapse']\").addEventListener(\"click\", collapseToRoot);\n    document.querySelector(\"[data-action='focus']\").addEventListener(\"click\", focusSelected);\n    showServiceInput.addEventListener(\"change\", () => { setShowService(showServiceInput.checked); render(); });\n    helpOverlayEl.addEventListener(\"click\", (event) => { if (event.target === helpOverlayEl || event.target.closest(\"[data-help-close]\")) closeHelp(); });\n    document.addEventListener(\"keydown\", (event) => { if (event.key === \"Escape\" && !helpOverlayEl.hidden) closeHelp(); });\n    document.getElementById('view-done').addEventListener('click', () => { if (!viewReadOnly) parent.postMessage({type:'view-handoff',config:viewConfig()}, '*'); });\n    window.addEventListener('message', event => {\n      if (event.source !== parent) return;\n      if (event.data?.type === 'view-init') { viewCanExpand = event.data.expandable === true; viewAccess(event.data.readOnly); buildInitialTree(event.data.config, event.data.ui); }\n      if (event.data?.type === 'view-access') viewAccess(event.data.readOnly);\n      if (event.data?.type === 'view-status') {\n        const button = document.getElementById('view-done');\n        button.disabled = Boolean(event.data.busy); button.textContent = event.data.busy ? 'Передаю…' : 'Готово — передать агенту';\n        document.querySelector('.page').inert = Boolean(event.data.busy);\n        if (event.data.message !== undefined) document.getElementById('view-status').textContent = event.data.message;\n      }\n    });\n    new ResizeObserver(viewResize).observe(document.querySelector('.page'));\n    window.addEventListener('resize', viewResize);\n    parent.postMessage({type:'view-ready'}, '*');\n    viewResize();\n  </script>\n</body>\n</html>\n"
